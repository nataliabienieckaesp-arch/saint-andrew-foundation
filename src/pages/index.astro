  <script is:inline>
    document.querySelectorAll('.donate-copy').forEach((button) => {
      button.addEventListener('click', async () => {
        const value = button.getAttribute('data-copy');
        if (!value) return;

        try {
          await navigator.clipboard.writeText(value);
        } catch {
          const input = document.createElement('textarea');
          input.value = value;
          input.setAttribute('readonly', '');
          input.style.position = 'absolute';
          input.style.left = '-9999px';
          document.body.appendChild(input);
          input.select();
          document.execCommand('copy');
          document.body.removeChild(input);
        }

        const copyIcon = button.querySelector('.donate-copy-icon');
        const doneIcon = button.querySelector('.donate-copy-done');
        if (copyIcon) copyIcon.style.display = 'none';
        if (doneIcon) doneIcon.style.display = 'block';
        const label = button.getAttribute('aria-label');
        button.setAttribute('aria-label', 'Copied');
        window.setTimeout(() => {
          if (copyIcon) copyIcon.style.display = 'block';
          if (doneIcon) doneIcon.style.display = 'none';
          if (label) button.setAttribute('aria-label', label);
        }, 2000);
      });
    });
  </script>

