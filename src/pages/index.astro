---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import { ArrowUpRight, ChevronRight, Heart } from 'lucide-astro';
---

<Layout>
  <!-- TOP BANNER -->
  <div class="top-banner" style="background-color: #001a3d; color: #f5f5f3; padding: 12px 48px; display: flex; justify-content: space-between; align-items: center; font-family: 'Courier New', monospace; font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase;">
    <span>Patron · British Embassy Warsaw</span>
    <span>KRS 0000557012 · Charity reg. since 2016</span>
  </div>

  <Navbar />

  <!-- HERO -->
  <section class="hero">
    <div class="hero-tartan" aria-hidden="true"></div>

    <div class="hero-headline-col hero-headline-col--home" style="position: relative; z-index: 2;">
      <div class="hero-headline-inner">
        <div style="display: flex; gap: 8px; align-items: center; font-family: 'Courier New', monospace; font-size: 12px; color: #c9a24a; text-transform: uppercase; letter-spacing: 0.04em;">
          <span>A Scottish</span><span>-</span><span>Polish Charity</span><span style="flex: 1; height: 1px; background: #c9a24a; margin-left: 8px;"></span><span>Warsaw</span>
        </div>
        <div class="hero-headline-wrap">
          <h1 class="hero-title-line">Bridging Scotland and Poland</h1>
          <h1 class="hero-title-line hero-title-line--accent">through charity</h1>
          <h1 class="hero-title-line">and culture.</h1>
        </div>
        <p style="font-size: 18px; color: white; line-height: 1.4; max-width: 564px;">The St. Andrews Foundation is a Scottish-themed Foundation in Poland dedicated to raising funds for vulnerable people facing illness and hardship, while celebrating Scotland's rich culture and strengthening the historic friendship between Scotland and Poland.</p>
      </div>
      <div class="hero-actions">
        <a href="#donate" class="btn btn--red">Donate now</a>
        <a href="/events#reserve" class="btn btn--outline-light">Reserve your place <ArrowUpRight size={18} /></a>
      </div>
    </div>

    <!-- Event card -->
    <div class="hero-event-card">
      <div style="display: flex; flex-direction: column; gap: 28px;">
        <div style="display: flex; flex-direction: column; gap: 16px;">
          <span style="font-family: 'Courier New', monospace; font-size: 12px; color: #e0ded8; text-transform: uppercase; letter-spacing: 0.015em;">Now — 28.11.2026</span>
          <h3 style="font-family: 'Newsreader', serif; font-size: 24px; color: white; margin: 0; font-weight: 500;">The Warsaw Charity Ceilidh</h3>
          <p style="font-size: 16px; color: white; font-weight: 500; margin: 0; line-height: 1.4;">Our annual charity gala — Częstochowa Pipes and Drums, dancing to the popular Cutting Edge Ceilidh Band from Scotland, great food, haggis, whisky, and a 100-year-old room in the heart of Warsaw. This is a charity event supporting ill and disadvantaged young Poles.</p>
        </div>
        <hr style="border: none; border-top: 1px solid #555; margin: 0;"/>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
          <div>
            <p style="font-family: 'Courier New', monospace; font-size: 12px; color: #e0ded8; text-transform: uppercase; margin: 0 0 8px 0;">Venue</p>
            <p style="font-size: 14px; color: white; font-weight: 500; margin: 0;">Reduta Banku Polskiego</p>
          </div>
          <div>
            <p style="font-family: 'Courier New', monospace; font-size: 12px; color: #e0ded8; text-transform: uppercase; margin: 0 0 8px 0;">Doors</p>
            <p style="font-size: 14px; color: white; font-weight: 500; margin: 0;">18:30</p>
          </div>
          <div>
            <p style="font-family: 'Courier New', monospace; font-size: 12px; color: #e0ded8; text-transform: uppercase; margin: 0 0 8px 0;">Seat</p>
            <p style="font-size: 14px; color: white; font-weight: 500; margin: 0;">PLN 600</p>
          </div>
          <div>
            <p style="font-family: 'Courier New', monospace; font-size: 12px; color: #e0ded8; text-transform: uppercase; margin: 0 0 8px 0;">Table of 10</p>
            <p style="font-size: 14px; color: white; font-weight: 500; margin: 0;">PLN 6 000</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS BAR -->
  <section class="stats-bar" style="background: linear-gradient(170deg, #052e14 0%, #030c08 71%); margin: 0 96px; border-radius: 16px; display: grid; grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr; align-items: center; margin-top: -40px; position: relative; z-index: 3;">
    <div class="stat-block" style="padding: 32px;">
      <p style="font-family: 'Newsreader', serif; font-size: 64px; font-weight: 700; color: white; margin: 0; line-height: 1.1; white-space: nowrap;">650K+</p>
      <div style="background: #c9a24a; height: 2px; width: 80px; margin: 12px 0;"></div>
      <p style="font-size: 16px; color: #f5f5f3; margin: 0; line-height: 1.6;">PLN donated since 2016</p>
    </div>
    <div class="stat-divider" style="background: rgba(224,222,216,0.5); width: 1px; height: 116px;"></div>
    <div class="stat-block" style="padding: 32px;">
      <p style="font-family: 'Newsreader', serif; font-size: 64px; font-weight: 700; color: white; margin: 0; line-height: 1.1; white-space: nowrap;">8+</p>
      <div style="background: #c9a24a; height: 2px; width: 80px; margin: 12px 0;"></div>
      <p style="font-size: 16px; color: #f5f5f3; margin: 0; line-height: 1.6;">Organisations supported</p>
    </div>
    <div class="stat-divider" style="background: rgba(224,222,216,0.5); width: 1px; height: 116px;"></div>
    <div class="stat-block" style="padding: 32px;">
      <p style="font-family: 'Newsreader', serif; font-size: 64px; font-weight: 700; color: white; margin: 0; line-height: 1.1;">8</p>
      <div style="background: #c9a24a; height: 2px; width: 80px; margin: 12px 0;"></div>
      <p style="font-size: 16px; color: #f5f5f3; margin: 0; line-height: 1.6;">Ceilidh editions</p>
    </div>
    <div class="stat-divider" style="background: rgba(224,222,216,0.5); width: 1px; height: 116px;"></div>
    <div class="stat-block" style="padding: 32px;">
      <p style="font-family: 'Newsreader', serif; font-size: 64px; font-weight: 700; color: white; margin: 0; line-height: 1.1;">10</p>
      <div style="background: #c9a24a; height: 2px; width: 80px; margin: 12px 0;"></div>
      <p style="font-size: 16px; color: #f5f5f3; margin: 0; line-height: 1.6;">Years active</p>
    </div>
  </section>
<!-- CEILIDH EVENT SECTION -->
  <section class="section-pad" style="padding: 64px 96px;">
    <div style="display: flex; flex-direction: column; gap: 32px;">
      <div style="display: flex; flex-direction: column; gap: 16px;">
        <div style="display: flex; gap: 12px; align-items: center;">
          <div style="background: #c8102e; height: 1px; width: 28px;"></div>
          <span style="font-family: 'Courier New', monospace; font-size: 12px; color: #c8102e; text-transform: uppercase; letter-spacing: 0.04em;">Flagship Event</span>
        </div>
        <h2 class="section-title" style="font-family: 'Newsreader', serif; font-size: 48px; font-weight: 700; color: black; margin: 0; letter-spacing: -0.01em;">The Warsaw Charity Ceilidh — An amazing night of fun and giving</h2>
        <div style="background: #8c0b20; height: 4px; width: 80px;"></div>
      </div>

      <div class="ceilidh-grid" style="border: 1px solid #e0ded8; border-radius: 16px; display: grid; grid-template-columns: 1fr 1fr; overflow: hidden;">
        <!-- Left image placeholder -->
        <img class="ceilidh-image" src="/images/ceilidh.jpg" alt="Ceilidh 2025" style="height: 732px; width: 100%; object-fit: cover;" />
        <div class="ceilidh-content" style="padding: 48px; display: flex; flex-direction: column; justify-content: space-between; height: 732px; box-sizing: border-box;">
          <div style="display: flex; flex-direction: column; gap: 16px;">
            <div style="display: flex; gap: 8px; align-items: center; font-family: 'Courier New', monospace; font-size: 12px; color: #c8102e; text-transform: uppercase; letter-spacing: 0.04em;">
              <span>9th edition</span><span>·</span><span>November 2026</span>
            </div>
            <h3 style="font-family: 'Newsreader', serif; font-size: 36px; font-weight: 600; color: black; margin: 0; line-height: 1.2;">An amazing night of fun and giving</h3>
            <div style="background: #8c0b20; height: 4px; width: 80px;"></div>
          </div>

          <p style="font-size: 18px; color: #333; line-height: 1.4; margin: 0;">Our annual charity gala — Częstochowa Pipes and Drums, dancing to the popular Cutting Edge Ceilidh Band from Scotland, great food, haggis, whisky, and a 100-year-old room in the heart of Warsaw. This is a charity event supporting ill and disadvantaged young Poles.</p>

          <div class="ceilidh-meta" style="border-top: 1px solid #e0ded8; border-bottom: 1px solid #e0ded8; padding: 16px 0; display: flex; flex-direction: column; gap: 16px;">
            <div class="ceilidh-meta-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
              <div>
                <p style="font-family: 'Courier New', monospace; font-size: 12px; color: #555; text-transform: uppercase; margin: 0 0 8px 0;">Date & Time</p>
                <p style="font-family: 'Newsreader', serif; font-size: 22px; font-weight: 600; color: #333; margin: 0; line-height: 1.3;">28 November 2026<br/>18:30</p>
              </div>
              <div>
                <p style="font-family: 'Courier New', monospace; font-size: 12px; color: #555; text-transform: uppercase; margin: 0 0 8px 0;">Venue</p>
                <p style="font-family: 'Newsreader', serif; font-size: 22px; font-weight: 600; color: #333; margin: 0; line-height: 1.3;">Reduta Banku Polskiego, Warsaw</p>
              </div>
            </div>
            <div class="ceilidh-meta-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
              <div>
                <p style="font-family: 'Courier New', monospace; font-size: 12px; color: #555; text-transform: uppercase; margin: 0 0 8px 0;">Patron</p>
                <p style="font-family: 'Newsreader', serif; font-size: 22px; font-weight: 600; color: #333; margin: 0; line-height: 1.3;">British Embassy Warsaw</p>
              </div>
              <div>
                <p style="font-family: 'Courier New', monospace; font-size: 12px; color: #555; text-transform: uppercase; margin: 0 0 8px 0;">Tickets</p>
                <p style="font-family: 'Newsreader', serif; font-size: 22px; font-weight: 600; color: #333; margin: 0; line-height: 1.3;">PLN 600</p>
              </div>
            </div>
          </div>

          <!-- Countdown -->
          <div class="countdown-row" style="display: flex; gap: 32px; align-items: center;" id="countdown">
            <div style="display: flex; flex-direction: column;">
              <span id="days" class="countdown-num" style="font-family: 'Newsreader', serif; font-size: 48px; font-weight: 700; color: #003f8a; line-height: 1.1;">--</span>
              <span style="font-family: 'Courier New', monospace; font-size: 12px; color: #999; text-transform: uppercase; letter-spacing: 0.04em;">days</span>
            </div>
            <div style="display: flex; flex-direction: column;">
              <span id="hours" class="countdown-num" style="font-family: 'Newsreader', serif; font-size: 48px; font-weight: 700; color: #003f8a; line-height: 1.1;">--</span>
              <span style="font-family: 'Courier New', monospace; font-size: 12px; color: #999; text-transform: uppercase; letter-spacing: 0.04em;">hours</span>
            </div>
            <div style="display: flex; flex-direction: column;">
              <span id="minutes" class="countdown-num" style="font-family: 'Newsreader', serif; font-size: 48px; font-weight: 700; color: #003f8a; line-height: 1.1;">--</span>
              <span style="font-family: 'Courier New', monospace; font-size: 12px; color: #999; text-transform: uppercase; letter-spacing: 0.04em;">minutes</span>
            </div>
            <div style="display: flex; flex-direction: column;">
              <span id="seconds" class="countdown-num" style="font-family: 'Newsreader', serif; font-size: 48px; font-weight: 700; color: #003f8a; line-height: 1.1;">--</span>
              <span style="font-family: 'Courier New', monospace; font-size: 12px; color: #999; text-transform: uppercase; letter-spacing: 0.04em;">seconds</span>
            </div>
          </div>

          <div class="ceilidh-buttons" style="display: flex; gap: 32px; align-items: center;">
            <a href="/events#reserve" class="btn btn--blue">Reserve your place <ArrowUpRight size={18} /></a>
            <a href="/events" class="btn btn--outline-blue">Check all events</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    function updateCountdown() {
      const eventDate = new Date('2026-11-28T18:30:00+01:00');
      const now = new Date();
      const diff = eventDate.getTime() - now.getTime();

      if (diff <= 0) return;

      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((diff % (1000 * 60)) / 1000);

      document.getElementById('days').textContent = String(days).padStart(2, '0');
      document.getElementById('hours').textContent = String(hours).padStart(2, '0');
      document.getElementById('minutes').textContent = String(minutes).padStart(2, '0');
      document.getElementById('seconds').textContent = String(seconds).padStart(2, '0');
    }

    updateCountdown();
    setInterval(updateCountdown, 1000);
  </script>

  <!-- AWARDS TEASER -->
  <section class="section-pad" style="background: #f4f0e8; padding: 64px 96px; display: flex; flex-direction: column; gap: 32px;">
    <div style="display: flex; flex-direction: column; gap: 16px;">
      <div style="display: flex; gap: 12px; align-items: center;">
        <div style="background: #c8102e; height: 1px; width: 28px;"></div>
        <span style="font-family: 'Courier New', monospace; font-size: 12px; color: #c8102e; text-transform: uppercase; letter-spacing: 0.04em;">The Award</span>
      </div>
      <h2 class="section-title" style="font-family: 'Newsreader', serif; font-size: 48px; font-weight: 700; color: #001a3d; margin: 0; letter-spacing: -0.01em;">Excellence in Promoting Scottish Culture</h2>
      <div style="background: #8c0b20; height: 4px; width: 80px;"></div>
    </div>

    <div class="awards-home-grid" style="border: 1px solid #e0ded8; border-radius: 16px; display: grid; grid-template-columns: 1fr 1fr; overflow: hidden; background: #ffffff;">
      <img class="awards-home-image" src="/images/awards/karol-kordyka.jpg" alt="Presentation of the St. Andrews Foundation Excellence Award" style="height: 480px; width: 100%; object-fit: cover; object-position: top center; display: block;" />
      <div class="awards-home-content" style="padding: 48px; display: flex; flex-direction: column; justify-content: center; gap: 24px;">
        <p style="font-size: 18px; color: #001a3d; line-height: 1.5; margin: 0;">Each year we honour people and organisations whose work brings Scotland's culture, heritage, education and business to life in Poland.</p>
        <p style="font-size: 18px; color: #001a3d; line-height: 1.5; margin: 0;">Meet the recipients of our Excellence Award, first presented in 2024.</p>
        <a href="/awards" class="btn btn--blue" style="align-self: flex-start;">View awards <ArrowUpRight size={18} /></a>
      </div>
    </div>
  </section>

  <!-- CHARITIES SECTION -->
  <section class="section-pad" style="background-color: #001a3d; padding: 64px 96px; display: flex; flex-direction: column; gap: 48px;">
    <div class="section-header-row" style="display: flex; justify-content: space-between; align-items: flex-end;">
      <div style="display: flex; flex-direction: column; gap: 16px; max-width: 600px;">
        <span style="font-family: 'Courier New', monospace; font-size: 12px; color: #c9a24a; text-transform: uppercase; letter-spacing: 0.04em;">Where the funds go</span>
        <h2 class="section-title" style="font-family: 'Newsreader', serif; font-size: 48px; font-weight: 700; color: white; margin: 0; letter-spacing: -0.01em;">The organizations we support</h2>
        <div style="background: #c9a24a; height: 4px; width: 80px;"></div>
      </div>
      <a href="/charities" class="btn btn--outline-light">See all charities <ArrowUpRight size={18} /></a>
    </div>

    <!-- Charity Cards -->
    <div class="cards-grid-2" style="display: grid; grid-template-columns: 1fr 1fr; gap: 32px;">

      <!-- Card 1 -->
      <div style="background: white; border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 16px; box-shadow: 0 4px 12px rgba(14,14,28,0.06);">
        <img src="/images/fundacja-iskierka.png" alt="Fundacja Iskierka" style="border-radius: 12px; height: 200px; width: 100%; object-fit: cover;" />
        <div style="background: #c8d9f2; display: inline-flex; padding: 4px 12px; border-radius: 999px;">
          <span style="font-size: 12px; font-weight: 600; color: #001535;">Children · Cancer</span>
        </div>
        <h3 style="font-family: 'Newsreader', serif; font-size: 28px; font-weight: 600; color: #333; margin: 0; line-height: 1.25;">Fundacja Iskierka</h3>
        <p style="font-size: 16px; color: #555; line-height: 1.6; margin: 0;">Since 2006, Fundacja Iskierka has been building support systems, therapies, and educational programmes in the field of paediatric oncology. Iskierka is our primary beneficiary and the heart of everything we do.</p>
      </div>

      <!-- Card 3 -->
      <div style="background: white; border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 16px; box-shadow: 0 4px 12px rgba(14,14,28,0.06);">
        <img src="/images/centrumrehabilitacji.jpg" alt="Centrum Rehabilitacji Helenów" style="border-radius: 12px; height: 200px; width: 100%; object-fit: cover;" />
        <div style="background: #c8d9f2; display: inline-flex; padding: 4px 12px; border-radius: 999px;">
          <span style="font-size: 12px; font-weight: 600; color: #001535;">Children · Disabilities</span>
        </div>
        <h3 style="font-family: 'Newsreader', serif; font-size: 28px; font-weight: 600; color: #333; margin: 0; line-height: 1.25;">Centrum Rehabilitacji Helenów</h3>
        <p style="font-size: 16px; color: #555; line-height: 1.6; margin: 0;">The Rehabilitation, Education and Care Centre TPD Helenów provides comprehensive functional and social rehabilitation for disabled children and teenagers in Warsaw. In 2020, the Foundation funded a hippotherapy arena at Helenów - a dedicated facility for horse-assisted therapy, opened on 24 June 2020..</p>
      </div>
    </div>

    <!-- Donate Card -->
    <div id="donate" class="donate-card" style="background: white; border: 1px solid #e0ded8; border-radius: 16px; padding: 48px 56px; max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; gap: 24px; align-items: center; text-align: center; box-shadow: 0 4px 24px rgba(14,14,28,0.06);">
      <span style="font-family: 'Courier New', monospace; font-size: 12px; color: #001a3d; text-transform: uppercase; letter-spacing: 0.04em;">Donate</span>
      <h2 style="font-family: 'Newsreader', serif; font-size: 36px; font-weight: 600; color: #001a3d; margin: 0; line-height: 1.15;">Would you simply like to support our work?</h2>
      <p style="font-size: 16px; color: #555; line-height: 1.6; margin: 0;">You do not need to attend the Ceilidh to support the St. Andrews Foundation. If you would like to make a donation independently of the November event, you can donate directly to the Foundation's account.</p>
      <div class="donate-details" style="background: #f4f0e8; border-radius: 12px; padding: 28px 32px; width: 100%; box-sizing: border-box; text-align: left;">
        <span style="font-family: 'Courier New', monospace; font-size: 12px; color: #8c0b20; text-transform: uppercase; letter-spacing: 0.04em;">Bank transfer</span>
        <dl style="margin: 16px 0 0; display: flex; flex-direction: column; gap: 14px;">
          <div>
            <dt style="font-size: 12px; color: #5a5a5a; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 4px;">Account name</dt>
            <dd style="margin: 0; font-size: 16px; color: #001a3d;">St. Andrews Foundation</dd>
          </div>
          <div>
            <dt style="font-size: 12px; color: #5a5a5a; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 4px;">Bank</dt>
            <dd style="margin: 0; font-size: 16px; color: #001a3d;">PKO Bank Polski</dd>
          </div>
          <div>
            <dt style="font-size: 12px; color: #5a5a5a; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 4px;">Account number</dt>
            <dd class="donate-account" style="margin: 0; font-size: 16px; color: #001a3d; display: flex; align-items: center; gap: 8px;">
              <span>75 1020 1169 0000 8202 0940 2977</span>
              <button type="button" class="donate-copy" data-copy="75 1020 1169 0000 8202 0940 2977" aria-label="Copy account number" title="Copy" style="display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: 32px; height: 32px; margin: 0; padding: 0; border: none; border-radius: 6px; background: transparent; cursor: pointer; color: #001a3d;">
                <span class="donate-copy-icon" aria-hidden="true" style="position: relative; display: block; width: 14px; height: 14px;">
                  <span style="position: absolute; right: 0; top: 0; width: 9px; height: 9px; border: 1.5px solid #001a3d; border-radius: 2px; box-sizing: border-box;"></span>
                  <span style="position: absolute; left: 0; bottom: 0; width: 9px; height: 9px; border: 1.5px solid #001a3d; border-radius: 2px; box-sizing: border-box; background: #f4f0e8;"></span>
                </span>
                <span class="donate-copy-done" aria-hidden="true" style="display: none; width: 12px; height: 7px; border-left: 2px solid #001a3d; border-bottom: 2px solid #001a3d; transform: rotate(-45deg); margin-bottom: 3px;"></span>
              </button>
            </dd>
          </div>
          <div>
            <dt style="font-size: 12px; color: #5a5a5a; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 4px;">SWIFT / BIC</dt>
            <dd style="margin: 0; font-size: 16px; color: #001a3d; display: flex; align-items: center; gap: 8px;">
              <span>BPKOPLPW</span>
              <button type="button" class="donate-copy" data-copy="BPKOPLPW" aria-label="Copy SWIFT / BIC" title="Copy" style="display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: 32px; height: 32px; margin: 0; padding: 0; border: none; border-radius: 6px; background: transparent; cursor: pointer; color: #001a3d;">
                <span class="donate-copy-icon" aria-hidden="true" style="position: relative; display: block; width: 14px; height: 14px;">
                  <span style="position: absolute; right: 0; top: 0; width: 9px; height: 9px; border: 1.5px solid #001a3d; border-radius: 2px; box-sizing: border-box;"></span>
                  <span style="position: absolute; left: 0; bottom: 0; width: 9px; height: 9px; border: 1.5px solid #001a3d; border-radius: 2px; box-sizing: border-box; background: #f4f0e8;"></span>
                </span>
                <span class="donate-copy-done" aria-hidden="true" style="display: none; width: 12px; height: 7px; border-left: 2px solid #001a3d; border-bottom: 2px solid #001a3d; transform: rotate(-45deg); margin-bottom: 3px;"></span>
              </button>
            </dd>
          </div>
          <div>
