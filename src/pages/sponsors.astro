---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import { ArrowUpRight } from 'lucide-astro';
---

<Layout>
  <!-- TOP BANNER -->
  <div class="top-banner" style="background-color: #001a3d; color: #f5f5f3; padding: 12px 48px; display: flex; justify-content: space-between; align-items: center; font-family: 'Courier New', monospace; font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase;">
    <span>Patron · British Embassy Warsaw</span>
    <span>KRS 0000557012 · Charity reg. since 2016</span>
  </div>

  <Navbar current="sponsors" />

  <!-- HERO -->
  <section class="page-hero page-hero--stacked">
    <div class="hero-headline-col">
      <div style="display: flex; gap: 8px; align-items: center; font-family: 'Courier New', monospace; font-size: 12px; color: #c9a24a; text-transform: uppercase; letter-spacing: 0.04em;">
        <span>Sponsors</span>
        <div style="height: 1px; width: 194px; background: #c9a24a;"></div>
      </div>
      <h1 class="page-hero-title" style="font-family: 'Newsreader', serif; font-size: 72px; font-weight: 400; line-height: 1.1; letter-spacing: -0.02em; color: white; margin: 0;">Your Partnership Makes the Difference in something Extraordinary</h1>
      <p style="font-size: 18px; color: white; line-height: 1.4; margin: 0; max-width: 564px;">Your brand is showcased alongside Warsaw's diplomatic community, business leaders and Scotland's community in Poland at one of the city's most prestigious charity events.</p>
      <a href="#sponsor" class="btn btn--gold" style="align-self: flex-start;">
        Become a sponsor <ArrowUpRight size={18} />
      </a>
    </div>
  </section>

  <!-- WHY SPONSOR STATS -->
  <section class="section-pad" style="background: #f4f0e8; padding: 64px 96px;">
    <div class="why-sponsor-grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px;">
      <div style="display: flex; flex-direction: column; gap: 8px;">
        <p style="font-family: 'Newsreader', serif; font-size: 48px; font-weight: 700; color: #002b60; margin: 0; line-height: 1.1;">300+</p>
        <p style="font-size: 16px; color: rgba(0,43,96,0.7); margin: 0; line-height: 1.5;">Guests per edition</p>
      </div>
      <div style="display: flex; flex-direction: column; gap: 8px;">
        <p style="font-family: 'Newsreader', serif; font-size: 28px; font-weight: 700; color: #002b60; margin: 0; line-height: 1.2;">Ambassadors & diplomats</p>
        <p style="font-size: 16px; color: rgba(0,43,96,0.7); margin: 0; line-height: 1.5;">In attendance every year</p>
      </div>
      <div style="display: flex; flex-direction: column; gap: 8px;">
        <p style="font-family: 'Newsreader', serif; font-size: 28px; font-weight: 700; color: #002b60; margin: 0; line-height: 1.2;">You make the difference</p>
        <p style="font-size: 16px; color: rgba(0,43,96,0.7); margin: 0; line-height: 1.5;">Sponsorship boosts the amount donated to worthy causes</p>
      </div>
    </div>
  </section>

  <!-- 2026 SPONSORS GRID -->
  <section class="section-pad" style="padding: 80px 96px; display: flex; flex-direction: column; gap: 48px;">
    <div class="sponsors-intro" style="display: flex; flex-direction: column; gap: 16px; max-width: 680px;">
      <div style="display: flex; gap: 12px; align-items: center;">
        <div style="background: #c8102e; height: 1px; width: 28px;"></div>
        <span style="font-family: 'Courier New', monospace; font-size: 12px; color: #c8102e; text-transform: uppercase; letter-spacing: 0.04em;">2026 Ceilidh</span>
      </div>
      <h2 class="section-title" style="font-family: 'Newsreader', serif; font-size: 48px; font-weight: 700; color: #002b60; margin: 0; letter-spacing: -0.01em;">Patrons of the 2026 edition.</h2>
      <div style="background: #8c0b20; height: 4px; width: 80px;"></div>

      <div class="sponsors-intro-copy" style="display: flex; flex-direction: column; gap: 16px; margin-top: 8px;">
        <p style="font-size: 16px; color: #001a3d; line-height: 1.6; margin: 0;">The work of the St. Andrews Foundation would not be possible without the generosity, commitment and goodwill of the many companies, organisations and individuals who have supported us over the years.</p>
        <p style="font-size: 16px; color: #001a3d; line-height: 1.6; margin: 0;">Their contributions help us organise our events, minimise our operating and event costs, and, most importantly, maximise the funds we are able to direct towards the charitable organisations and causes we support in Poland.</p>
        <p style="font-size: 16px; color: #001a3d; line-height: 1.6; margin: 0;">We are sincerely grateful to every sponsor and partner, past and present, who has contributed financially, provided products or services, donated prizes and experiences, or supported us in so many other ways. Their generosity plays an important part in turning our fundraising efforts into tangible support for children and young people facing illness, disability and other difficult circumstances.</p>
      </div>
      <p class="sponsors-intro-close" style="font-size: 16px; color: #001a3d; line-height: 1.6; margin: 16px 0 0; padding-top: 24px; border-top: 1px solid #e0ded8;">While we extend our heartfelt thanks to everyone who has supported the Foundation, we would like to give special recognition to those sponsors and partners whose continued commitment has accompanied us over many years:</p>
      <p class="sponsors-thanks" style="font-family: 'Newsreader', serif; font-size: 28px; font-weight: 600; color: #001a3d; margin: 8px 0 0; letter-spacing: -0.01em;">With our sincere thanks to:</p>
    </div>

    <div class="sponsors-grid-top" style="display: grid; grid-template-columns: repeat(5, 1fr); border-top: 1px solid #e0ded8; border-left: 1px solid #e0ded8;">
      <div class="sponsor-logo-cell">
        <div class="sponsor-logo-box sponsor-logo-box--top">
          <img src="/images/sponsor-logos/logo-DomWhiskey.jpeg" alt="Dom Whisky" width="300" height="300" loading="lazy" />
        </div>
      </div>
      <div class="sponsor-logo-cell">
        <div class="sponsor-logo-box sponsor-logo-box--top">
          <img src="/images/sponsor-logos/logo-perla.jpg" alt="Perła" width="841" height="595" loading="lazy" />
        </div>
      </div>
      <div class="sponsor-logo-cell">
        <div class="sponsor-logo-box sponsor-logo-box--top">
          <img src="/images/sponsor-logos/logo-mielzynski-herb.jpg" alt="Mielżyński" width="438" height="200" loading="lazy" />
        </div>
      </div>
      <div class="sponsor-logo-cell">
        <div class="sponsor-logo-box sponsor-logo-box--top">
          <img src="/images/sponsor-logos/logo-volvo.jpeg" alt="Volvo" width="891" height="280" loading="lazy" />
        </div>
      </div>
      <div class="sponsor-logo-cell">
        <div class="sponsor-logo-box sponsor-logo-box--top">
          <img src="/images/sponsor-logos/logo-CMYK.jpg" alt="Eland Cables" width="1418" height="2051" loading="lazy" />
        </div>
      </div>
    </div>

    <div class="sponsors-grid" style="display: grid; grid-template-columns: repeat(5, 1fr); border-top: 1px solid #e0ded8; border-left: 1px solid #e0ded8;">
      <div class="sponsor-logo-cell">
        <div class="sponsor-logo-box sponsor-logo-box--rest">
          <img src="/images/sponsor-logos/logo-gym-generation.jpg" alt="Gym Generation" width="215" height="139" loading="lazy" />
        </div>
        <p class="sponsor-logo-title">Gym Generation</p>
      </div>
      <div class="sponsor-logo-cell">
        <div class="sponsor-logo-box sponsor-logo-box--rest">
          <img src="/images/sponsor-logos/logo-java.jpg" alt="Java Coffee Roasters" width="676" height="353" loading="lazy" />
        </div>
        <p class="sponsor-logo-title">Java Coffee Roasters</p>
      </div>
      <div class="sponsor-logo-cell">
        <div class="sponsor-logo-box sponsor-logo-box--rest">
          <img src="/images/sponsor-logos/logo-laKoguta.jpg" alt="La Koguta" width="158" height="192" loading="lazy" />
        </div>
        <p class="sponsor-logo-title">La Koguta</p>
      </div>
      <div class="sponsor-logo-cell">
        <div class="sponsor-logo-box sponsor-logo-box--rest">
          <img src="/images/sponsor-logos/logo-ramsay.jpg" alt="Ramsay &amp; Co." width="2250" height="2250" loading="lazy" />
        </div>
        <p class="sponsor-logo-title">Ramsay &amp; Co.</p>
      </div>
      <div class="sponsor-logo-cell">
        <div class="sponsor-logo-box sponsor-logo-box--rest">
          <img src="/images/sponsor-logos/logo-spirecapital.jpg" alt="Spire Capital" width="1080" height="1080" loading="lazy" />
        </div>
        <p class="sponsor-logo-title">Spire Capital</p>
      </div>
    </div>
  </section>

  <!-- BECOME A SPONSOR FORM -->
  <section id="sponsor" class="section-pad sponsor-form-section" style="background: #f4f0e8; padding: 80px 96px; display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start;">
    <div style="display: flex; flex-direction: column; gap: 24px;">
      <div style="display: flex; gap: 12px; align-items: center;">
        <div style="background: #c8102e; height: 1px; width: 28px;"></div>
        <span style="font-family: 'Courier New', monospace; font-size: 12px; color: #c8102e; text-transform: uppercase; letter-spacing: 0.04em;">Get involved</span>
      </div>
      <h2 class="section-title" style="font-family: 'Newsreader', serif; font-size: 48px; font-weight: 700; color: #002b60; margin: 0; letter-spacing: -0.01em;">Put your brand where generosity, elegance, and celebration meet.</h2>
      <div style="background: #8c0b20; height: 4px; width: 80px;"></div>
      <p style="font-size: 18px; color: rgba(0,43,96,0.8); line-height: 1.4; margin: 0;">We respond to all enquiries within 48 hours.</p>
      <p style="font-size: 16px; color: rgba(0,43,96,0.8); line-height: 1.6; margin: 0;">Want to support the Ceilidh without a full sponsorship package? Donate a product, service, or experience to our auction or lottery — completely free of charge. Past prizes have included a weekend with a Volvo, aged whisky and magnum wines, golf passes, gym memberships, spa kits, designer accessories, and original artwork. Let your brand be part of the excitement.</p>
      <div style="display: flex; flex-direction: column; gap: 12px; margin-top: 8px;">
        <div style="display: flex; gap: 16px; align-items: center;">
          <div style="background: #c8102e; width: 5px; min-width: 5px; height: 5px; border-radius: 999px;"></div>
          <p style="font-size: 16px; color: rgba(0,43,96,0.8); margin: 0;">Reach Warsaw's British & international business community</p>
        </div>
        <div style="display: flex; gap: 16px; align-items: center;">
          <div style="background: #c8102e; width: 5px; min-width: 5px; height: 5px; border-radius: 999px;"></div>
          <p style="font-size: 16px; color: rgba(0,43,96,0.8); margin: 0;">Associate your brand with genuine charitable impact</p>
        </div>
        <div style="display: flex; gap: 16px; align-items: center;">
          <div style="background: #c8102e; width: 5px; min-width: 5px; height: 5px; border-radius: 999px;"></div>
          <p style="font-size: 16px; color: rgba(0,43,96,0.8); margin: 0;">Entertain clients at Warsaw's most distinctive Scottish evening</p>
        </div>
      </div>
    </div>

    <form
  name="sponsor-enquiry"
  method="POST"
  netlify  netlify-honeypot="bot-field"
  style="background: white; border-radius: 16px; padding: 40px; display: flex; flex-direction: column; gap: 20px;"
>
  <input type="hidden" name="form-name" value="sponsor-enquiry" />
  <p style="display: none;"><label>Leave empty: <input name="bot-field" /></label></p>

  <h3 style="font-family: 'Newsreader', serif; font-size: 28px; font-weight: 600; color: #002b60; margin: 0;">Become a sponsor</h3>

  <div style="display: flex; flex-direction: column; gap: 8px;">
    <label style="font-size: 12px; font-weight: 500; color: #555; text-transform: uppercase; letter-spacing: 0.04em;">Company name</label>
    <input type="text" name="company" required placeholder="Your company" style="border: 1px solid #e0ded8; border-radius: 8px; padding: 12px 16px; font-size: 16px; outline: none; width: 100%; box-sizing: border-box;" />
  </div>
  <div style="display: flex; flex-direction: column; gap: 8px;">
    <label style="font-size: 12px; font-weight: 500; color: #555; text-transform: uppercase; letter-spacing: 0.04em;">Contact name</label>
    <input type="text" name="name" required placeholder="Your name" style="border: 1px solid #e0ded8; border-radius: 8px; padding: 12px 16px; font-size: 16px; outline: none; width: 100%; box-sizing: border-box;" />
  </div>
  <div style="display: flex; flex-direction: column; gap: 8px;">
    <label style="font-size: 12px; font-weight: 500; color: #555; text-transform: uppercase; letter-spacing: 0.04em;">Email</label>
    <input type="email" name="email" required placeholder="you@company.com" style="border: 1px solid #e0ded8; border-radius: 8px; padding: 12px 16px; font-size: 16px; outline: none; width: 100%; box-sizing: border-box;" />
  </div>
  <div style="display: flex; flex-direction: column; gap: 8px;">
    <label style="font-size: 12px; font-weight: 500; color: #555; text-transform: uppercase; letter-spacing: 0.04em;">Message (optional)</label>
    <textarea name="message" placeholder="Any questions or specific requirements?" rows="3" style="border: 1px solid #e0ded8; border-radius: 8px; padding: 12px 16px; font-size: 16px; outline: none; width: 100%; box-sizing: border-box; resize: vertical; font-family: inherit;"></textarea>
  </div>
  <button type="submit" class="btn btn--blue btn--block">Become a sponsor</button>
</form>
  </section>

  <Footer />
</Layout>

<style>
  .sponsor-logo-cell {
    background: #ffffff;
    border-right: 1px solid #e0ded8;
    border-bottom: 1px solid #e0ded8;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 20px 16px;
    min-width: 0;
    box-sizing: border-box;
  }

  .sponsor-logo-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    box-sizing: border-box;
  }

  .sponsor-logo-box--top {
    height: 148px;
  }

  .sponsor-logo-box--rest {
    height: 96px;
  }

  .sponsor-logo-title {
    font-family: 'Newsreader', serif;
    font-size: 18px;
    font-weight: 600;
    color: #001a3d;
    margin: 0;
    text-align: center;
    line-height: 1.2;
  }

  .sponsor-logo-box img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  /* ============ RESPONSIVE ============ */

  /* Tablet */
  @media (max-width: 1024px) {
    .top-banner { padding: 10px 32px !important; }

    .page-hero {
      display: flex !important;
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 40px !important;
      padding: 64px 32px !important;
    }
    .hero-headline-col { width: 100% !important; min-width: 0 !important; }
    .page-hero-title { font-size: 52px !important; }

    .section-pad { padding: 48px 32px !important; }
    .section-title { font-size: 36px !important; }

    .why-sponsor-grid { grid-template-columns: 1fr 1fr !important; }

    .sponsors-grid-top,
    .sponsors-grid { grid-template-columns: repeat(3, 1fr) !important; }

    .sponsor-form-section {
      grid-template-columns: 1fr !important;
      gap: 40px !important;
    }
  }

  /* Phones */
  @media (max-width: 640px) {
    .top-banner {
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 4px !important;
      padding: 10px 20px !important;
      font-size: 10px !important;
    }

    .page-hero { padding: 48px 20px !important; }
    .page-hero-title { font-size: 34px !important; }

    .section-pad { padding: 40px 20px !important; }
    .section-title { font-size: 28px !important; }
    .sponsors-thanks { font-size: 22px !important; }

    .why-sponsor-grid { grid-template-columns: 1fr !important; }
    .sponsors-grid-top,
    .sponsors-grid { grid-template-columns: repeat(2, 1fr) !important; }

    .sponsor-logo-box--top { height: 96px; }
    .sponsor-logo-box--rest { height: 72px; }
    .sponsor-logo-title { font-size: 14px; }
  }
</style>
