---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { ArrowUpRight } from 'lucide-astro';
import { posts } from '../data/posts.js';

const years = [...new Set(posts.map(p => p.year))].sort((a, b) => b - a);
---

<Layout>
  <!-- TOP BANNER -->
  <div class="top-banner" style="background-color: #001a3d; color: #f5f5f3; padding: 12px 48px; display: flex; justify-content: space-between; align-items: center; font-family: 'Courier New', monospace; font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase;">
    <span>Patron · British Embassy Warsaw</span>
    <span>KRS 0000557012 · Charity reg. since 2016</span>
  </div>

  <Navbar current="news" />

  <!-- HERO -->
  <section class="page-hero">
    <div class="hero-headline-col" style="flex: 1;">
      <div style="display: flex; gap: 8px; align-items: center; font-family: 'Courier New', monospace; font-size: 12px; color: #c9a24a; text-transform: uppercase; letter-spacing: 0.04em;">
        <span>News</span>
        <div style="height: 1px; width: 194px; background: #c9a24a;"></div>
      </div>
      <h1 class="page-hero-title" style="font-family: 'Newsreader', serif; font-size: 64px; font-weight: 400; line-height: 1.1; letter-spacing: -0.02em; color: white; margin: 0;">Notes from the Foundation.</h1>
      <p style="font-size: 18px; color: white; line-height: 1.4; margin: 0;">Announcements, thank-yous and reports from a decade of ceilidhs, balls and Scottish days in Poland.</p>
    </div>

    <!-- Year index -->
    <div class="hero-side-box" style="width: 506px; border-top: 1px solid rgba(255,255,255,0.15);">
      {years.map(y => (
        <a href={`#year-${y}`} style="border-bottom: 1px solid rgba(255,255,255,0.15); padding: 20px 0; display: flex; justify-content: space-between; align-items: center; text-decoration: none;">
          <p style="font-family: 'Newsreader', serif; font-size: 32px; font-weight: 600; font-style: italic; color: #c9a24a; margin: 0;">{y}</p>
          <p style="font-family: 'Courier New', monospace; font-size: 12px; color: rgba(255,255,255,0.7); text-transform: uppercase; letter-spacing: 0.04em; margin: 0;">
            {posts.filter(p => p.year === y).length} {posts.filter(p => p.year === y).length === 1 ? 'post' : 'posts'}
          </p>
        </a>
      ))}
    </div>
  </section>

  <!-- POSTS BY YEAR -->
  {years.map(year => (
    <section id={`year-${year}`} class="news-year">

      <div class="news-year__head">
        <p class="news-year__label">{year}</p>
        <div class="news-year__rule"></div>
      </div>

      {posts.filter(p => p.year === year).map((post, i) => (
        <article class="news-card">

          <!-- LEFT: photo, tags, date -->
          <div class="news-card__left">
            <div class="news-card__photo">
              {post.img
                ? <img src={post.img} alt={post.title} />
                : <span class="news-card__monogram">SAF</span>
              }
            </div>
            <div class="news-card__tags">
              {(post.tags || [post.category]).map(t => (
                <span class="news-card__tag">{t}</span>
              ))}
            </div>
            <time datetime={post.dateISO} class="news-card__date">{post.date}</time>
          </div>

          <!-- RIGHT: headline + text -->
          <div class="news-card__right">
            <div class="news-card__head">
              <h2 class="news-card__title">{post.title}</h2>
              <div class="news-card__titlerule"></div>
            </div>

            <div class="news-card__body">
              {post.body.map(block => (
                block.type === 'quote'
                  ? <blockquote class="news-card__quote">{block.text}</blockquote>
                  : <p class="news-card__para">{block.text}</p>
              ))}

              {post.sponsors && post.sponsors.length > 0 && (
                <div class="news-card__sponsors">
                  {post.sponsors.map(s => (
                    <a href={s.url} target="_blank" rel="noopener noreferrer">{s.name}</a>
                  ))}
                </div>
              )}
            </div>

            <button class="news-card__toggle" type="button">Read more</button>
          </div>
        </article>
      ))}
    </section>
  ))}

  <Footer />
</Layout>

<style>
  /* ---------- Year sections ---------- */
  .news-year {
    padding: 56px 96px 0 96px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .news-year:last-of-type {
    padding-bottom: 80px;
  }
  .news-year__head {
    display: flex;
    gap: 24px;
    align-items: center;
  }
  .news-year__label {
    font-family: 'Newsreader', serif;
    font-size: 48px;
    font-weight: 600;
    font-style: italic;
    color: #c9a24a;
    margin: 0;
    line-height: 1;
  }
  .news-year__rule {
    flex: 1;
    height: 1px;
    background: #e0ded8;
  }

  /* ---------- Card shell ---------- */
  .news-card {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 48px;
    height: 360px;
    padding: 28px;
    border: 1px solid #e0ded8;
    border-radius: 16px;
    background: white;
    overflow: hidden;
  }
  .news-card.is-open {
    height: auto;
  }

  /* ---------- Left column ---------- */
  .news-card__left {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .news-card__photo {
    height: 200px;
    border-radius: 12px;
    overflow: hidden;
    background: #f4f0e8;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .news-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .news-card__monogram {
    font-family: 'Newsreader', serif;
    font-size: 40px;
    font-weight: 700;
    color: rgba(0, 43, 96, 0.15);
  }
  .news-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .news-card__tag {
    background: #c8d9f2;
    color: #001535;
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
  }
  .news-card__date {
    font-family: 'Courier New', monospace;
    font-size: 11px;
    color: #999;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* ---------- Right column ---------- */
  .news-card__right {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }
  .news-card__head {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .news-card__title {
    font-family: 'Newsreader', serif;
    font-size: 32px;
    font-weight: 600;
    color: #002b60;
    margin: 0;
    line-height: 1.2;
  }
  .news-card__titlerule {
    background: #8c0b20;
    height: 3px;
    width: 60px;
  }

  .news-card__body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    overflow: hidden;
    position: relative;
    max-height: 150px;
  }
  .news-card.is-open .news-card__body {
    max-height: none;
  }
  /* soft fade where the text is cut */
  .news-card__body::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 48px;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0), #ffffff);
    pointer-events: none;
  }
  .news-card.is-open .news-card__body::after {
    display: none;
  }

  .news-card__para {
    font-size: 16px;
    color: rgba(0, 43, 96, 0.8);
    line-height: 1.7;
    margin: 0;
  }
  .news-card__quote {
    border-left: 3px solid #8c0b20;
    padding-left: 18px;
    margin: 4px 0;
    font-family: 'Newsreader', serif;
    font-size: 19px;
    font-style: italic;
    font-weight: 500;
    color: #003f8a;
    line-height: 1.4;
  }

  /* ---------- Sponsor wall inside a post ---------- */
  .news-card__sponsors {
    margin-top: 8px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid #e0ded8;
    border-left: 1px solid #e0ded8;
  }
  .news-card__sponsors a {
    border-right: 1px solid #e0ded8;
    border-bottom: 1px solid #e0ded8;
    padding: 18px 10px;
    min-height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-decoration: none;
    font-family: 'Newsreader', serif;
    font-size: 15px;
    font-weight: 600;
    color: #002b60;
  }
  .news-card__sponsors a:hover {
    background: #f4f0e8;
  }

  /* ---------- Toggle ---------- */
  .news-card__toggle {
    align-self: flex-start;
    margin-top: auto;
    background: none;
    border: 1px solid #e0ded8;
    color: #002b60;
    padding: 8px 20px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
  }
  .news-card__toggle:hover {
    border-color: #002b60;
  }
  .news-card__toggle.is-hidden {
    display: none;
  }

  /* ---------- CTA ---------- */
  .news-cta {
    background: #001a3d;
    padding: 80px 96px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
    margin-top: 64px;
  }
  .news-cta__left {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .news-cta__right {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* ============ RESPONSIVE ============ */

  /* Tablet */
  @media (max-width: 1024px) {
    .top-banner {
      padding: 10px 32px !important;
    }

    /* Bridging fix for .page-hero — works regardless of its base definition */
    .page-hero {
      display: flex !important;
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 40px !important;
      padding: 64px 32px !important;
    }

    .hero-headline-col,
    .hero-side-box {
      width: 100% !important;
      min-width: 0 !important;
      flex: none !important;
    }

    .page-hero-title {
      font-size: 44px !important;
    }

    .news-year {
      padding: 40px 32px 0 32px;
    }

    .news-year__label {
      font-size: 36px;
    }

    .news-card {
      grid-template-columns: 240px 1fr;
      gap: 28px;
      height: 320px;
      padding: 20px;
    }

    .news-card__sponsors {
      grid-template-columns: repeat(2, 1fr);
    }

    .news-cta {
      padding: 56px 32px;
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  /* Phones */
  @media (max-width: 640px) {
    .top-banner {
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 4px !important;
      padding: 10px 20px !important;
      font-size: 10px !important;
    }

    .page-hero {
      padding: 48px 20px !important;
    }

    .page-hero-title {
      font-size: 30px !important;
    }

    .news-year {
      padding: 32px 20px 0 20px;
      gap: 16px;
    }

    .news-year:last-of-type {
      padding-bottom: 48px;
    }

    .news-year__label {
      font-size: 28px;
    }

    /* Stack the card: photo on top, text below, height grows naturally */
    .news-card {
      grid-template-columns: 1fr;
      gap: 16px;
      height: auto;
      padding: 16px;
    }

    .news-card__photo {
      height: 180px;
    }

    .news-card__title {
      font-size: 24px;
    }

    .news-card__sponsors {
      grid-template-columns: 1fr;
    }

    .news-cta {
      padding: 40px 20px;
    }
  }
</style>

<script is:inline>
  document.querySelectorAll('.news-card').forEach(card => {
    const body = card.querySelector('.news-card__body');
    const btn = card.querySelector('.news-card__toggle');
    if (!body || !btn) return;

    // Nothing clipped? Hide the button so short posts don't get a dead control.
    if (body.scrollHeight <= body.clientHeight + 4) {
      btn.classList.add('is-hidden');
      return;
    }

    btn.addEventListener('click', () => {
      const open = card.classList.toggle('is-open');
      btn.textContent = open ? 'Read less' : 'Read more';
    });
  });
</script>
