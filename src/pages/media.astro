---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import { ArrowUpRight, ChevronLeft, ChevronRight, Mail, X } from 'lucide-astro';

const IMAGE_EXT = /\.(jpe?g|png|webp|gif)$/i;

function readImageSize(filePath) {
  const buf = fs.readFileSync(filePath);
  if (buf.length >= 24 && buf[0] === 0x89 && buf[1] === 0x50) {
    return { width: buf.readUInt32BE(16), height: buf.readUInt32BE(20) };
  }
  if (buf[0] === 0xff && buf[1] === 0xd8) {
    let offset = 2;
    while (offset + 8 < buf.length) {
      if (buf[offset] !== 0xff) break;
      const marker = buf[offset + 1];
      if (marker === 0xd8 || marker === 0xd9 || (marker >= 0xd0 && marker <= 0xd7)) {
        offset += 2;
        continue;
      }
      const segmentSize = buf.readUInt16BE(offset + 2);
      if (
        (marker >= 0xc0 && marker <= 0xc3) ||
        (marker >= 0xc5 && marker <= 0xc7) ||
        (marker >= 0xc9 && marker <= 0xcb) ||
        (marker >= 0xcd && marker <= 0xcf)
      ) {
        return {
          height: buf.readUInt16BE(offset + 5),
          width: buf.readUInt16BE(offset + 7),
        };
      }
      if (segmentSize < 2) break;
      offset += 2 + segmentSize;
    }
  }
  return { width: 1600, height: 1200 };
}

function loadAlbum(folder) {
  const abs = path.join(process.cwd(), 'public', 'images', folder);
  return fs
    .readdirSync(abs)
    .filter((name) => IMAGE_EXT.test(name) && fs.statSync(path.join(abs, name)).isFile())
    .sort((a, b) => a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' }))
    .map((name) => {
      const { width, height } = readImageSize(path.join(abs, name));
      return {
        src: `/images/${folder}/${encodeURIComponent(name)}`,
        width,
        height,
      };
    });
}

const lordSpeakerPhotos = loadAlbum('lord-speaker-visit-2024');
const ceilidh2024Photos = loadAlbum('ceilidh-2024');
const ceilidh2025Photos = loadAlbum('ceilidh-2025');

const albums = [
  {
    id: 'lord-speaker',
    kicker: 'Official visit · 2024',
    title: 'Visit of the Lord Speaker of the House of Lords',
    intro: 'Photographs from a 2024 diplomatic visit, shown separately from the Foundation’s charity events.',
    alt: 'Photograph from the Visit of the Lord Speaker of the House of Lords',
    photos: lordSpeakerPhotos,
    featured: true,
    coverFile: '8.jpeg',
  },
  {
    id: 'ceilidh-2025',
    kicker: 'Charity Ceilidh',
    title: '2025 event highlights',
    intro: '',
    alt: 'Photograph from the 2025 event',
    photos: ceilidh2025Photos,
    featured: false,
  },
  {
    id: 'ceilidh-2024',
    kicker: 'Charity Ceilidh',
    title: '2024 event highlights',
    intro: '',
    alt: 'Photograph from the 2024 event',
    photos: ceilidh2024Photos,
    featured: false,
  },
];

function albumCover(album) {
  if (album.coverFile) {
    const match = album.photos.find((photo) =>
      decodeURIComponent(photo.src.split('/').pop() || '') === album.coverFile
    );
    if (match) return match;
  }
  return album.photos[0];
}

const featuredAlbum = albums.find((album) => album.featured);
const eventAlbums = albums.filter((album) => !album.featured);
const featuredCover = featuredAlbum && albumCover(featuredAlbum);
---

<Layout>
  <!-- TOP BANNER -->
  <div class="top-banner" style="background-color: #001a3d; color: #f5f5f3; padding: 12px 48px; display: flex; justify-content: space-between; align-items: center; font-family: 'Courier New', monospace; font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase;">
    <span>Patron · British Embassy Warsaw</span>
    <span>KRS 0000557012 · Charity reg. since 2016</span>
  </div>

  <Navbar current="media" />

  <!-- HERO -->
  <section class="page-hero page-hero--stacked">
    <div class="hero-headline-col">
      <div style="display: flex; gap: 8px; align-items: center; font-family: 'Courier New', monospace; font-size: 12px; color: #c9a24a; text-transform: uppercase; letter-spacing: 0.04em;">
        <span>Media</span>
        <div style="height: 1px; width: 194px; background: #c9a24a;"></div>
      </div>
      <h1 class="page-hero-title" style="font-family: 'Newsreader', serif; font-size: 72px; font-weight: 400; line-height: 1.1; letter-spacing: -0.02em; color: white; margin: 0;">An evening in pictures.</h1>
      <p style="font-size: 18px; color: white; line-height: 1.4; margin: 0;">Three hundred guests, one night, thousands of photographs. Browse the galleries from every Ceilidh and Caledonian Ball below. Full-resolution images are available to download — for press use, please credit St. Andrews Foundation.</p>
    </div>
  </section>

  <!-- OFFICIAL VISIT ALBUM -->
  <section class="section-pad" style="padding: 80px 96px; display: flex; flex-direction: column; gap: 24px;">
    {featuredAlbum && featuredCover && (
      <button
        type="button"
        class="album-card album-card--featured"
        data-open-album={featuredAlbum.id}
        aria-haspopup="dialog"
        aria-controls="album-viewer"
        aria-label={`Open album: ${featuredAlbum.title}`}
      >
        <img
          src={featuredCover.src}
          alt=""
          width={featuredCover.width}
          height={featuredCover.height}
          loading="eager"
          decoding="async"
        />
        <div class="album-card-overlay">
          <div style="display: flex; gap: 12px; align-items: center;">
            <div style="background: #c9a24a; height: 1px; width: 28px;"></div>
            <span style="font-family: 'Courier New', monospace; font-size: 12px; color: #c9a24a; text-transform: uppercase; letter-spacing: 0.04em;">{featuredAlbum.kicker} · {featuredAlbum.photos.length} photographs</span>
          </div>
          <span class="album-card-title" style="font-family: 'Newsreader', serif; font-size: 40px; font-weight: 700; color: white; letter-spacing: -0.01em;">{featuredAlbum.title}</span>
          <p style="font-size: 16px; color: rgba(255,255,255,0.85); line-height: 1.6; margin: 0; max-width: 640px;">{featuredAlbum.intro}</p>
          <span class="album-card-cta">Open album <ArrowUpRight size={18} /></span>
        </div>
      </button>
    )}
  </section>

  <!-- EVENT PHOTO ALBUMS -->
  <section class="section-pad" style="padding: 80px 96px; display: flex; flex-direction: column; gap: 48px;">
    <div class="galleries-header-row" style="display: flex; justify-content: space-between; align-items: flex-end; gap: 48px;">
      <div style="display: flex; flex-direction: column; gap: 16px;">
        <div style="display: flex; gap: 12px; align-items: center;">
          <div style="background: #c8102e; height: 1px; width: 28px;"></div>
          <span style="font-family: 'Courier New', monospace; font-size: 12px; color: #c8102e; text-transform: uppercase; letter-spacing: 0.04em;">Galleries</span>
        </div>
        <h2 class="section-title" style="font-family: 'Newsreader', serif; font-size: 48px; font-weight: 700; color: #002b60; margin: 0; letter-spacing: -0.01em;">Browse by event.</h2>
        <div style="background: #8c0b20; height: 4px; width: 80px;"></div>
      </div>
      <p style="font-size: 16px; color: rgba(0,43,96,0.7); line-height: 1.6; margin: 0; max-width: 400px;">All photography by our volunteer photographers. Free to use with credit for press and partners.</p>
    </div>

    <div class="album-card-grid">
      {eventAlbums.map((album) => (
        album.photos[0] && (
          <button
            type="button"
            class="album-card"
            data-open-album={album.id}
            aria-haspopup="dialog"
            aria-controls="album-viewer"
            aria-label={`Open album: ${album.title}`}
          >
            <img
              src={album.photos[0].src}
              alt=""
              width={album.photos[0].width}
              height={album.photos[0].height}
              loading="lazy"
              decoding="async"
            />
            <div class="album-card-overlay">
              <span style="font-family: 'Courier New', monospace; font-size: 12px; color: #c9a24a; text-transform: uppercase; letter-spacing: 0.04em;">{album.kicker} · {album.photos.length} photographs</span>
              <span class="album-card-title" style="font-family: 'Newsreader', serif; font-size: 32px; font-weight: 600; color: white; letter-spacing: -0.01em;">{album.title}</span>
              <span class="album-card-cta">Open album <ArrowUpRight size={16} /></span>
            </div>
          </button>
        )
      ))}
    </div>
  </section>

  <!-- PRESS & MEDIA -->
  <section id="press" class="section-pad" style="background: #001a3d; padding: 80px 96px; display: flex; flex-direction: column; gap: 48px;">
    <div style="display: flex; flex-direction: column; gap: 16px;">
      <span style="font-family: 'Courier New', monospace; font-size: 12px; color: #c9a24a; text-transform: uppercase; letter-spacing: 0.04em;">Press & Media</span>
      <h2 class="section-title" style="font-family: 'Newsreader', serif; font-size: 48px; font-weight: 700; color: white; margin: 0; letter-spacing: -0.01em;">What's been written about us.</h2>
      <div style="background: #c9a24a; height: 4px; width: 80px;"></div>
    </div>

    <div class="press-section" style="display: grid; grid-template-columns: 2fr 1fr; gap: 64px; align-items: start;">

      <!-- Press coverage list -->
      <div style="border-top: 1px solid rgba(255,255,255,0.15);">
        {[
          { outlet: 'The Warsaw Voice', title: 'Scots in Warsaw raise a million for Polish children', date: 'December 2025' },
          { outlet: 'Gazeta Wyborcza', title: 'Szkocki bal w sercu Warszawy — dziesięć lat pomocy', date: 'November 2025' },
          { outlet: 'The Scotsman', title: 'How a Warsaw ceilidh became a lifeline for sick children', date: 'March 2025' },
          { outlet: 'BBC Scotland', title: 'The tartan that stitches Scotland to Poland', date: 'November 2024' },
          { outlet: 'Rzeczpospolita', title: 'Fundacja św. Andrzeja: whisky, dudy i milion złotych', date: 'December 2023' },
        ].map(item => (
          <a href="#" class="press-row" style="border-bottom: 1px solid rgba(255,255,255,0.15); padding: 24px 0; display: flex; justify-content: space-between; align-items: center; gap: 32px; text-decoration: none;">
            <div style="display: flex; flex-direction: column; gap: 6px;">
              <span style="font-family: 'Courier New', monospace; font-size: 11px; color: #c9a24a; text-transform: uppercase; letter-spacing: 0.04em;">{item.outlet} · {item.date}</span>
              <p style="font-family: 'Newsreader', serif; font-size: 22px; font-weight: 600; color: white; margin: 0; line-height: 1.3;">{item.title}</p>
            </div>
            <span style="color: #c9a24a; flex-shrink: 0;"><ArrowUpRight size={20} /></span>
          </a>
        ))}
      </div>

      <!-- Press contact card -->
      <div style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.15); border-radius: 16px; padding: 32px; display: flex; flex-direction: column; gap: 20px;">
        <h3 style="font-family: 'Newsreader', serif; font-size: 24px; font-weight: 600; color: white; margin: 0;">Press enquiries</h3>
        <p style="font-size: 15px; color: rgba(255,255,255,0.7); line-height: 1.6; margin: 0;">Journalists and media partners — we're happy to provide interviews, photography, and background on the Foundation's work.</p>

        <div style="border-top: 1px solid rgba(255,255,255,0.15); padding-top: 20px; display: flex; flex-direction: column; gap: 16px;">
          <div>
            <p style="font-family: 'Courier New', monospace; font-size: 11px; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 0.04em; margin: 0 0 6px 0;">Contact</p>
            <p style="font-family: 'Newsreader', serif; font-size: 18px; font-weight: 600; color: white; margin: 0;">David Kennedy</p>
            <p style="font-size: 13px; color: rgba(255,255,255,0.6); margin: 2px 0 0 0;">Foundation Secretary</p>
          </div>
          <div>
            <p style="font-family: 'Courier New', monospace; font-size: 11px; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 0.04em; margin: 0 0 6px 0;">Email</p>
            <a href="mailto:press@standrewsfoundation.pl" style="font-size: 15px; color: #c9a24a; text-decoration: none;">press@standrewsfoundation.pl</a>
          </div>
          <div>
            <p style="font-family: 'Courier New', monospace; font-size: 11px; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 0.04em; margin: 0 0 6px 0;">Response time</p>
            <p style="font-size: 15px; color: white; margin: 0;">Within 48 hours</p>
          </div>
        </div>

        <a href="mailto:press@standrewsfoundation.pl" class="btn btn--gold btn--md">
          Get in touch <Mail size={16} />
        </a>
      </div>

    </div>
  </section>

  <!-- NEXT EVENT HIGHLIGHT -->
  <section class="section-pad next-event-outer" style="background: #f4f0e8; padding: 80px 96px; display: flex; justify-content: center;">
    <div class="next-event-card" style="background: #001a3d; border-radius: 16px; padding: 64px; width: 100%; display: grid; grid-template-columns: 1fr auto; gap: 64px; align-items: center; position: relative; overflow: hidden;">

      <div style="display: flex; flex-direction: column; gap: 20px; position: relative; z-index: 2;">
        <div style="display: flex; gap: 12px; align-items: center;">
          <div style="background: #c9a24a; height: 1px; width: 28px;"></div>
          <span style="font-family: 'Courier New', monospace; font-size: 12px; color: #c9a24a; text-transform: uppercase; letter-spacing: 0.04em;">Next event · 28 November 2026</span>
        </div>
        <h2 class="next-event-title" style="font-family: 'Newsreader', serif; font-size: 52px; font-weight: 400; color: white; margin: 0; line-height: 1.1; letter-spacing: -0.01em;">Join us for the <span style="font-style: italic; color: #c9a24a;">next</span> Ceilidh.</h2>
        <p style="font-size: 18px; color: rgba(255,255,255,0.8); line-height: 1.5; margin: 0; max-width: 560px;">Pipes, dancing, haggis and a hundred stories at Reduta Banku Polskiego, Warsaw. Be part of the photographs we'll be showing here next year.</p>
        <div class="next-event-buttons" style="display: flex; gap: 16px; margin-top: 8px;">
          <a href="/events" class="btn btn--red">
            Donate and join the event <ArrowUpRight size={18} />
          </a>
          <a href="/events" class="btn btn--outline-ghost">See all events</a>
        </div>
      </div>

      <!-- Countdown -->
      <div class="next-event-countdown" style="display: flex; gap: 24px; position: relative; z-index: 2; border-left: 1px solid rgba(255,255,255,0.15); padding-left: 64px;">
        <div style="text-align: center;">
          <p id="m-days" style="font-family: 'Newsreader', serif; font-size: 44px; font-weight: 700; color: #c9a24a; margin: 0; line-height: 1.1;">--</p>
          <p style="font-family: 'Courier New', monospace; font-size: 11px; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 0.04em; margin: 0;">days</p>
        </div>
        <div style="text-align: center;">
          <p id="m-hours" style="font-family: 'Newsreader', serif; font-size: 44px; font-weight: 700; color: #c9a24a; margin: 0; line-height: 1.1;">--</p>
          <p style="font-family: 'Courier New', monospace; font-size: 11px; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 0.04em; margin: 0;">hours</p>
        </div>
        <div style="text-align: center;">
          <p id="m-minutes" style="font-family: 'Newsreader', serif; font-size: 44px; font-weight: 700; color: #c9a24a; margin: 0; line-height: 1.1;">--</p>
          <p style="font-family: 'Courier New', monospace; font-size: 11px; color: rgba(255,255,255,0.5); text-transform: uppercase; letter-spacing: 0.04em; margin: 0;">mins</p>
        </div>
      </div>

    </div>
  </section>

  <dialog class="album-viewer" id="album-viewer" aria-labelledby="album-viewer-title">
    <div class="album-viewer-chrome">
      <div class="album-viewer-heading">
        <p id="album-viewer-kicker" class="album-viewer-kicker"></p>
        <h2 id="album-viewer-title" class="album-viewer-title"></h2>
      </div>
      <button type="button" class="album-viewer-close" aria-label="Close album">
        <X size={20} />
      </button>
    </div>

    <div class="album-viewer-body">
      {albums.map((album) => (
        <div
          class:list={['album-grid', album.featured && 'album-grid--official']}
          data-album-panel={album.id}
          hidden
        >
          {album.photos.map((photo, index) => (
            <button
              type="button"
              class="album-thumb"
              data-lightbox-src={photo.src}
              data-lightbox-alt={album.alt}
              data-lightbox-album={album.id}
              data-lightbox-index={String(index)}
              aria-label={`View photograph ${index + 1} of ${album.photos.length} from ${album.title}`}
            >
              <img
                src={photo.src}
                alt={album.alt}
                width={photo.width}
                height={photo.height}
                loading="lazy"
                decoding="async"
              />
            </button>
          ))}
        </div>
      ))}
    </div>

    <div class="photo-stage" id="photo-stage" hidden>
      <button type="button" class="lightbox-close" data-close-photo aria-label="Back to album">
        <X size={20} />
      </button>
      <button type="button" class="lightbox-nav lightbox-prev" aria-label="Previous photograph">
        <ChevronLeft size={28} />
      </button>
      <img class="lightbox-image" alt="" />
      <button type="button" class="lightbox-nav lightbox-next" aria-label="Next photograph">
        <ChevronRight size={28} />
      </button>
      <p id="lightbox-caption" class="lightbox-caption"></p>
    </div>
  </dialog>

  <Footer />

  <script>
    function updateMediaCountdown() {
      const eventDate = new Date('2026-11-28T18:30:00+01:00');
      const diff = eventDate.getTime() - new Date().getTime();
      if (diff <= 0) return;
      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      document.getElementById('m-days').textContent = String(days).padStart(2, '0');
      document.getElementById('m-hours').textContent = String(hours).padStart(2, '0');
      document.getElementById('m-minutes').textContent = String(minutes).padStart(2, '0');
    }
    updateMediaCountdown();
    setInterval(updateMediaCountdown, 1000);
  </script>

  <script>
    const viewer = document.getElementById('album-viewer');
    const kickerEl = document.getElementById('album-viewer-kicker');
    const titleEl = document.getElementById('album-viewer-title');
    const closeAlbumBtn = viewer.querySelector('.album-viewer-close');
    const photoStage = document.getElementById('photo-stage');
    const lightboxImage = photoStage.querySelector('.lightbox-image');
    const lightboxCaption = document.getElementById('lightbox-caption');
    const closePhotoBtn = photoStage.querySelector('[data-close-photo]');
    const prevBtn = photoStage.querySelector('.lightbox-prev');
    const nextBtn = photoStage.querySelector('.lightbox-next');
    const panels = () => [...viewer.querySelectorAll('[data-album-panel]')];
    const albumCards = [...document.querySelectorAll('[data-open-album]')];

    let lastCard = null;
    let lastThumb = null;
    let currentAlbum = '';
    let currentIndex = 0;
    let photoOpen = false;

    function albumThumbs(album) {
      const panel = viewer.querySelector(`[data-album-panel="${album}"]`);
      return panel ? [...panel.querySelectorAll('.album-thumb')] : [];
    }

    function photoFocusable() {
      return [closePhotoBtn, prevBtn, nextBtn];
    }

    function showPanel(album) {
      panels().forEach((panel) => {
        panel.hidden = panel.dataset.albumPanel !== album;
      });
    }

    function openAlbum(card) {
      lastCard = card;
      currentAlbum = card.dataset.openAlbum;
      const thumbs = albumThumbs(currentAlbum);
      kickerEl.textContent = `${thumbs.length} photographs`;
      titleEl.textContent = card.querySelector('.album-card-title')?.textContent || 'Album';
      showPanel(currentAlbum);
      hidePhoto();
      if (typeof viewer.showModal === 'function') viewer.showModal();
      else viewer.setAttribute('open', '');
      closeAlbumBtn.focus();
      const body = viewer.querySelector('.album-viewer-body');
      if (body) body.scrollTop = 0;
    }

    function closeAlbum() {
      hidePhoto();
      if (typeof viewer.close === 'function' && viewer.open) viewer.close();
      else viewer.removeAttribute('open');
    }

    function showPhoto(index) {
      const items = albumThumbs(currentAlbum);
      if (!items.length) return;
      currentIndex = (index + items.length) % items.length;
      const btn = items[currentIndex];
      lastThumb = btn;
      lightboxImage.alt = btn.dataset.lightboxAlt || '';
      lightboxImage.src = btn.dataset.lightboxSrc;
      lightboxCaption.textContent = `${currentIndex + 1} of ${items.length}`;
      photoStage.hidden = false;
      photoOpen = true;
      closePhotoBtn.focus();
    }

    function hidePhoto() {
      photoStage.hidden = true;
      photoOpen = false;
      lightboxImage.removeAttribute('src');
    }

    albumCards.forEach((card) => {
      card.addEventListener('click', () => openAlbum(card));
    });

    viewer.addEventListener('click', (event) => {
      const thumb = event.target.closest('.album-thumb');
      if (thumb && viewer.contains(thumb) && !photoOpen) {
        showPhoto(Number(thumb.dataset.lightboxIndex));
        return;
      }
      if (event.target === viewer && !photoOpen) closeAlbum();
    });

    closeAlbumBtn.addEventListener('click', closeAlbum);
    closePhotoBtn.addEventListener('click', () => {
      hidePhoto();
      lastThumb?.focus();
    });
    prevBtn.addEventListener('click', () => showPhoto(currentIndex - 1));
    nextBtn.addEventListener('click', () => showPhoto(currentIndex + 1));

    photoStage.addEventListener('click', (event) => {
      if (event.target === photoStage) {
        hidePhoto();
        lastThumb?.focus();
      }
    });

    viewer.addEventListener('cancel', (event) => {
      if (photoOpen) {
        event.preventDefault();
        hidePhoto();
        lastThumb?.focus();
      }
    });

    viewer.addEventListener('close', () => {
      hidePhoto();
      lastCard?.focus();
    });

    viewer.addEventListener('keydown', (event) => {
      if (!viewer.open) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        if (photoOpen) {
          hidePhoto();
          lastThumb?.focus();
        } else {
          closeAlbum();
        }
        return;
      }
      if (!photoOpen) return;
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        showPhoto(currentIndex - 1);
        return;
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        showPhoto(currentIndex + 1);
        return;
      }
      if (event.key !== 'Tab') return;
      const nodes = photoFocusable();
      const first = nodes[0];
      const last = nodes[nodes.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    let swipeX = null;
    lightboxImage.addEventListener('touchstart', (event) => {
      swipeX = event.changedTouches[0].clientX;
    }, { passive: true });
    lightboxImage.addEventListener('touchend', (event) => {
      if (!photoOpen || swipeX == null) return;
      const delta = event.changedTouches[0].clientX - swipeX;
      swipeX = null;
      if (Math.abs(delta) < 40) return;
      showPhoto(currentIndex + (delta < 0 ? 1 : -1));
    });
  </script>
</Layout>

