---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import { ArrowUpRight } from 'lucide-astro';
---

<Layout>
  <!-- TOP BANNER -->
  <div class="top-banner" style="background-color: #001a3d; color: #f5f5f3; padding: 12px 48px; display: flex; justify-content: space-between; align-items: center; font-family: 'Courier New', monospace; font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase;">
    <span>Patron · British Embassy Warsaw</span>
    <span>KRS 0000557012 · Charity reg. since 2016</span>
  </div>

  <Navbar current="events" />

  <!-- HERO -->
  <section class="page-hero">
    <div class="hero-headline-col">
      <div style="display: flex; gap: 8px; align-items: center; font-family: 'Courier New', monospace; font-size: 12px; color: #c9a24a; text-transform: uppercase; letter-spacing: 0.04em;">
        <span>Events</span>
        <div style="height: 1px; width: 194px; background: #c9a24a;"></div>
      </div>
      <h1 class="page-hero-title" style="font-family: 'Newsreader', serif; font-size: 72px; font-weight: 400; line-height: 1.1; letter-spacing: -0.02em; color: white; margin: 0;">Where Scotland meets Poland — every year.</h1>
      <p style="font-size: 18px; color: white; line-height: 1.4; margin: 0; max-width: 564px;">Scottish culture is promoted in Poland by various groups of Polish enthusiasts throughout the year and we admire and respect them for taking such an active interest in Scotland. Our website will reference these and we will mention events they are staging in our communications mainly on social media. Whilst the Foundation is present as a guest at various occasions, there are currently two flagship events where we are most visible. One of those is clearly the St. Andrews Foundation Charity Ceilidh and the other is the Scottish Day in Jadów where the Foundation is one of the official Patrons. This is a fantastic event that celebrates Scottish culture held usually the first Saturday in July.</p>
    </div>

    <!-- Event list -->
    <div class="hero-side-box" style="width: 506px; border-top: 1px solid rgba(255,255,255,0.15);">
      <div style="border-bottom: 1px solid rgba(255,255,255,0.15); padding: 24px 0; display: flex; justify-content: space-between; align-items: center;">
        <p style="font-family: 'Newsreader', serif; font-size: 22px; font-weight: 600; color: white; margin: 0;">The Warsaw Charity Ceilidh</p>
        <p style="font-size: 16px; color: #c9a24a; margin: 0;">28 November 2026</p>
      </div>
      <div style="border-bottom: 1px solid rgba(255,255,255,0.15); padding: 24px 0; display: flex; justify-content: space-between; align-items: center;">
        <p style="font-family: 'Newsreader', serif; font-size: 22px; font-weight: 600; color: white; margin: 0;">Burns Night Warsaw</p>
        <p style="font-size: 16px; color: #c9a24a; margin: 0;">January 2027</p>
      </div>
      <div style="padding: 24px 0; display: flex; justify-content: space-between; align-items: center;">
        <p style="font-family: 'Newsreader', serif; font-size: 22px; font-weight: 600; color: white; margin: 0;">Scottish Day Jadów</p>
        <p style="font-size: 16px; color: #c9a24a; margin: 0;">4 July 2026</p>
      </div>
    </div>
  </section>

  <!-- CEILIDH SECTION -->
  <section id="ceilidh" class="section-pad" style="padding: 64px 96px; display: flex; flex-direction: column; gap: 48px;">
    <div style="display: flex; flex-direction: column; gap: 16px;">
      <div style="display: flex; gap: 12px; align-items: center;">
        <div style="background: #c8102e; height: 1px; width: 28px;"></div>
        <span style="font-family: 'Courier New', monospace; font-size: 12px; color: #c8102e; text-transform: uppercase; letter-spacing: 0.04em;">Flagship Event</span>
      </div>
      <h2 class="section-title" style="font-family: 'Newsreader', serif; font-size: 48px; font-weight: 700; color: #002b60; margin: 0; letter-spacing: -0.01em;">The Warsaw Charity Ceilidh — An amazing night of fun and giving</h2>
      <div style="background: #8c0b20; height: 4px; width: 80px;"></div>
    </div>

    <!-- Details + countdown -->
    <div class="ceilidh-details-row" style="display: flex; justify-content: space-between; align-items: flex-start; gap: 48px;">
      <div style="display: flex; flex-direction: column; gap: 24px; max-width: 560px;">
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
          <span style="border: 1px solid #003f8a; color: #003f8a; padding: 5px 12px; border-radius: 999px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em;">Annual</span>
          <span style="border: 1px solid #003f8a; color: #003f8a; padding: 5px 12px; border-radius: 999px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em;">November</span>
          <span style="border: 1px solid #003f8a; color: #003f8a; padding: 5px 12px; border-radius: 999px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em;">Warsaw</span>
        </div>
        <p style="font-size: 16px; color: rgba(0,43,96,0.7); line-height: 1.6; margin: 0;">Our annual charity gala — Częstochowa Pipes and Drums, dancing to the popular Cutting Edge Ceilidh Band from Scotland, great food, haggis, whisky, and a 100-year-old room in the heart of Warsaw. All proceeds go to ill and disadvantaged young Poles.</p>
        <p style="font-size: 16px; color: rgba(0,43,96,0.7); line-height: 1.6; margin: 0;"><strong>What is a Ceilidh?</strong> Traditional Scottish group dancing — no experience needed, and no ability to follow instructions required either. A caller guides everyone through the steps as the music plays. The less you know what you're doing, the more fun it is. Trust us.</p>
      </div>

      <div class="ceilidh-details-right" style="display: flex; flex-direction: column; gap: 16px; min-width: 500px;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
          <div>
            <p style="font-family: 'Courier New', monospace; font-size: 12px; color: #555; text-transform: uppercase; margin: 0 0 8px 0;">Date & Time</p>
            <p style="font-family: 'Newsreader', serif; font-size: 22px; font-weight: 600; color: #333; margin: 0; line-height: 1.3;">28 November 2026, 18:30</p>
          </div>
          <div>
            <p style="font-family: 'Courier New', monospace; font-size: 12px; color: #555; text-transform: uppercase; margin: 0 0 8px 0;">Venue</p>
            <p style="font-family: 'Newsreader', serif; font-size: 22px; font-weight: 600; color: #333; margin: 0; line-height: 1.3;">Reduta Banku Polskiego, Warsaw</p>
          </div>
          <div>
            <p style="font-family: 'Courier New', monospace; font-size: 12px; color: #555; text-transform: uppercase; margin: 0 0 8px 0;">Patron</p>
            <p style="font-family: 'Newsreader', serif; font-size: 22px; font-weight: 600; color: #333; margin: 0; line-height: 1.3;">British Embassy Warsaw</p>
          </div>
          <div>
            <p style="font-family: 'Courier New', monospace; font-size: 12px; color: #555; text-transform: uppercase; margin: 0 0 8px 0;">Seat</p>
            <p style="font-family: 'Newsreader', serif; font-size: 22px; font-weight: 600; color: #333; margin: 0; line-height: 1.3;">PLN 600</p>
          </div>
          <div>
            <p style="font-family: 'Courier New', monospace; font-size: 12px; color: #555; text-transform: uppercase; margin: 0 0 8px 0;">Table of 10</p>
            <p style="font-family: 'Newsreader', serif; font-size: 22px; font-weight: 600; color: #333; margin: 0; line-height: 1.3;">PLN 6,000</p>
          </div>
          <div>
            <p style="font-family: 'Courier New', monospace; font-size: 12px; color: #555; text-transform: uppercase; margin: 0 0 8px 0;">Doors</p>
            <p style="font-family: 'Newsreader', serif; font-size: 22px; font-weight: 600; color: #333; margin: 0; line-height: 1.3;">18:30</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Countdown + CTA -->
    <div class="countdown-cta-row" style="display: flex; justify-content: space-between; align-items: center;">
      <div class="countdown-row" style="display: flex; gap: 32px;">
        <div>
          <p id="days" class="countdown-num" style="font-family: 'Newsreader', serif; font-size: 48px; font-weight: 700; color: #003f8a; margin: 0; line-height: 1.1;">--</p>
          <p style="font-family: 'Courier New', monospace; font-size: 12px; color: #999; text-transform: uppercase; letter-spacing: 0.04em; margin: 0;">days</p>
        </div>
        <div>
          <p id="hours" class="countdown-num" style="font-family: 'Newsreader', serif; font-size: 48px; font-weight: 700; color: #003f8a; margin: 0; line-height: 1.1;">--</p>
          <p style="font-family: 'Courier New', monospace; font-size: 12px; color: #999; text-transform: uppercase; letter-spacing: 0.04em; margin: 0;">hours</p>
        </div>
        <div>
          <p id="minutes" class="countdown-num" style="font-family: 'Newsreader', serif; font-size: 48px; font-weight: 700; color: #003f8a; margin: 0; line-height: 1.1;">--</p>
          <p style="font-family: 'Courier New', monospace; font-size: 12px; color: #999; text-transform: uppercase; letter-spacing: 0.04em; margin: 0;">minutes</p>
        </div>
        <div>
          <p id="seconds" class="countdown-num" style="font-family: 'Newsreader', serif; font-size: 48px; font-weight: 700; color: #003f8a; margin: 0; line-height: 1.1;">--</p>
          <p style="font-family: 'Courier New', monospace; font-size: 12px; color: #999; text-transform: uppercase; letter-spacing: 0.04em; margin: 0;">seconds</p>
        </div>
      </div>
      <a href="#reserve" class="btn btn--blue">
        Reserve your place
      </a>
    </div>

    <!-- Full width photo -->
    <div class="feature-photo" style="height: 597px; background: #001535; border-radius: 16px; overflow: hidden; display: flex; align-items: center; justify-content: center; object-position: top;">
      <img src="/images/St_Andrews_Foundation_0046.jpg" alt="St_Andrews_Foundation_0047.jpg" style="width: 100%; height: 100%; object-fit: cover;" />
    </div>
  </section>

  <!-- TICKETS & RESERVATIONS -->
  <section id="reserve" class="section-pad" style="padding: 64px 96px; display: flex; flex-direction: column; gap: 32px;">
    <h2 class="section-title" style="font-family: 'Newsreader', serif; font-size: 48px; font-weight: 700; color: #002b60; margin: 0; letter-spacing: -0.01em;">How to reserve your tickets</h2>
    <div style="background: #8c0b20; height: 4px; width: 80px;"></div>

    <ol class="reserve-steps">
      <li class="reserve-step reserve-step--action">
        <div>
          <h3 style="font-family: 'Newsreader', serif; font-size: 22px; font-weight: 600; color: #001a3d; margin: 0 0 8px; line-height: 1.3;">Request your tickets</h3>
          <p style="font-size: 16px; color: #333; line-height: 1.6; margin: 0;">Please email one of the St. Andrews Foundation organisers below, stating your name and the number of tickets you would like to reserve.</p>
          <ul class="reserve-contacts">
            <li>Paul Gogolinski — <a class="reserve-email" href="mailto:paul@standrewsfoundation.pl">paul@standrewsfoundation.pl</a></li>
            <li>Iain Haggis — <a class="reserve-email" href="mailto:iainh@standrewsfoundation.pl">iainh@standrewsfoundation.pl</a></li>
          </ul>
        </div>
      </li>
      <li class="reserve-step">
        <div>
          <h3 style="font-family: 'Newsreader', serif; font-size: 22px; font-weight: 600; color: #002b60; margin: 0 0 8px; line-height: 1.3;">Receive your donation advice</h3>
          <p style="font-size: 16px; color: rgba(0,43,96,0.7); line-height: 1.6; margin: 0;">The Foundation will confirm availability and send you a donation advice note, together with the Foundation's bank details and payment information.</p>
        </div>
      </li>
      <li class="reserve-step">
        <div>
          <h3 style="font-family: 'Newsreader', serif; font-size: 22px; font-weight: 600; color: #002b60; margin: 0 0 8px; line-height: 1.3;">Make your contribution</h3>
          <p style="font-size: 16px; color: rgba(0,43,96,0.7); line-height: 1.6; margin: 0;">Please make the requested payment by bank transfer using the details provided.</p>
        </div>
      </li>
      <li class="reserve-step">
        <div>
          <h3 style="font-family: 'Newsreader', serif; font-size: 22px; font-weight: 600; color: #002b60; margin: 0 0 8px; line-height: 1.3;">Receive your confirmation and tickets</h3>
          <p style="font-size: 16px; color: rgba(0,43,96,0.7); line-height: 1.6; margin: 0;">Once your contribution has been received and recorded in the Foundation's bank account, we will send you confirmation together with your event tickets.</p>
        </div>
      </li>
    </ol>
  </section>

  <!-- BURNS NIGHT -->
  <section id="burns" class="section-pad two-col-section" style="padding: 64px 96px; display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center;">
    <div style="display: flex; flex-direction: column; gap: 32px;">
      <div style="display: flex; flex-direction: column; gap: 16px;">
        <div style="display: flex; gap: 12px; align-items: center;">
          <div style="background: #c8102e; height: 1px; width: 28px;"></div>
          <span style="font-family: 'Courier New', monospace; font-size: 12px; color: #c8102e; text-transform: uppercase; letter-spacing: 0.04em;">Burns Night</span>
        </div>
        <h2 class="section-title" style="font-family: 'Newsreader', serif; font-size: 48px; font-weight: 700; color: #002b60; margin: 0; letter-spacing: -0.01em;">A night for Rabbie.</h2>
        <div style="background: #8c0b20; height: 4px; width: 80px;"></div>
      </div>

      <p style="font-size: 16px; color: rgba(0,43,96,0.7); line-height: 1.6; margin: 0; max-width: 560px;">An evening celebrating Scotland's national poet, Robert Burns — held annually in Warsaw each January around Burns Night (25 January). This is another great event for everyone and is also an ideal occasion for corporate hosting given its more sedate tempo and affording quiet conversation. Of course, we will aim to raise more donations for the causes we support. During this unique yet global phenomenon, you can experience: The Address to a Haggis, the Immortal Memory, a Selkirk Grace, Scottish Piping and song plus a few drams of Scotland's prime export! Open to all who love Scotland, or who would like to. Date and venue for 2027 to be confirmed — register your interest below and we will be in touch.</p>

      <div style="display: flex; flex-direction: column; gap: 16px;">
        <div style="display: flex; flex-direction: column; gap: 8px;">
          <p style="font-family: 'Courier New', monospace; font-size: 12px; color: #555; text-transform: uppercase; letter-spacing: 0.015em; margin: 0;">Details</p>
          <p style="font-family: 'Newsreader', serif; font-size: 22px; font-weight: 600; color: #333; margin: 0; line-height: 1.3;">TBA</p>
        </div>
        <div style="display: flex; flex-direction: column; gap: 8px;">
          <p style="font-family: 'Courier New', monospace; font-size: 12px; color: #555; text-transform: uppercase; letter-spacing: 0.015em; margin: 0;">Tickets</p>
          <p style="font-family: 'Newsreader', serif; font-size: 22px; font-weight: 600; color: #333; margin: 0; line-height: 1.3;">Via contact form</p>
        </div>
      </div>

      <a href="#" class="btn btn--blue" style="align-self: flex-start;">
        Register interest <ArrowUpRight size={18} />
      </a>
    </div>

    <div class="feature-photo" style="height: 458px; overflow: hidden; background: #001535;">
      <img src="/images/St_Andrews_Foundation_0005.jpg" alt="Burns Night" style="width: 100%; height: 100%; object-fit: cover;" />
    </div>
  </section>

  <!-- SCOTTISH DAY IN JADÓW -->
  <section class="section-pad" style="background-color: #001a3d; padding: 64px 96px; display: flex; flex-direction: column; gap: 48px;">
    <div class="section-header-row-alt" style="display: flex; justify-content: space-between; align-items: flex-start; gap: 48px;">
      <div style="display: flex; flex-direction: column; gap: 16px;">
        <span style="font-family: 'Courier New', monospace; font-size: 12px; color: #c9a24a; text-transform: uppercase; letter-spacing: 0.04em;">Community Event</span>
        <h2 class="section-title" style="font-family: 'Newsreader', serif; font-size: 48px; font-weight: 700; color: white; margin: 0; letter-spacing: -0.01em;">Scottish Day in Jadów.</h2>
        <div style="background: #c9a24a; height: 4px; width: 80px;"></div>
      </div>
      <p class="scottish-day-text" style="font-size: 18px; color: rgba(255,255,255,0.7); line-height: 1.4; margin: 0; max-width: 564px; padding-top: 48px;">Every summer, the village of Jadów hosts a Scottish cultural day that has grown into one of the most distinctive events in the Scottish-Polish calendar. Bagpipes, Highland games, Scottish food, and the warm hospitality of a Polish village — all in one afternoon. The St. Andrews Foundation has supported the Scottish Day in Jadów from the beginning, and Foundation has actively supported the event. Next Scottish Day — 4th July 2026.</p>
    </div>

    <div class="photo-grid-2" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; height: 529px;">
      <div class="photo-grid-2-item" style="border-radius: 16px; overflow: hidden; background: #001535;">
        <img src="/images/St_Andrews_Foundation_0010.jpg" alt="Scottish Day Jadow" style="width: 100%; height: 100%; object-fit: cover;" />
      </div>
      <div class="photo-grid-2-item" style="border-radius: 16px; overflow: hidden; background: #001535;">
        <img src="/images/St_Andrews_Foundation_0006.jpg" alt="Scottish Day Jadow" style="width: 100%; height: 100%; object-fit: cover;" />
      </div>
    </div>
  </section>

  <Footer />

  <script>
    function updateCountdown() {
      const eventDate = new Date('2026-11-28T18:30:00+01:00');
      const now = new Date();
      const diff = eventDate.getTime() - now.getTime();
      if (diff <= 0) return;
      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((diff % (1000 * 60)) / 1000);
      document.getElementById('days').textContent = String(days).padStart(2, '0');
      document.getElementById('hours').textContent = String(hours).padStart(2, '0');
      document.getElementById('minutes').textContent = String(minutes).padStart(2, '0');
      document.getElementById('seconds').textContent = String(seconds).padStart(2, '0');
    }
    updateCountdown();
    setInterval(updateCountdown, 1000);
  </script>
</Layout>

<style>
  .reserve-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
    counter-reset: reserve-step;
    max-width: 800px;
  }

  .reserve-step {
    counter-increment: reserve-step;
    display: grid;
    grid-template-columns: 48px 1fr;
    column-gap: 24px;
    align-items: start;
    min-width: 0;
  }

  .reserve-step::before {
    content: counter(reserve-step);
    font-family: 'Newsreader', serif;
    font-size: 36px;
    font-weight: 700;
    color: #003f8a;
    line-height: 1.1;
  }

  .reserve-step--action {
    background: white;
    border: 1px solid #e0ded8;
    border-radius: 16px;
    padding: 24px 28px;
    box-shadow: 0 4px 12px rgba(14, 14, 28, 0.06);
  }

  .reserve-step--action::before {
    color: #8c0b20;
    font-size: 48px;
  }

  .reserve-contacts {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 16px;
    color: #001a3d;
    line-height: 1.4;
  }

  .reserve-email {
    color: #003f8a;
    text-decoration: underline;
    text-underline-offset: 2px;
    overflow-wrap: anywhere;
  }

  .reserve-email:hover {
    color: #001a3d;
  }

  .reserve-email:focus-visible {
    outline: 2px solid #001a3d;
    outline-offset: 2px;
  }

  /* ============ RESPONSIVE ============ */

  /* Tablet */
  @media (max-width: 1024px) {
    .top-banner {
      padding: 10px 32px !important;
    }

    /* Bridging fix for .page-hero — works regardless of its base definition */
    .page-hero {
      display: flex !important;
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 40px !important;
      padding: 64px 32px !important;
    }

    .hero-headline-col,
    .hero-side-box {
      width: 100% !important;
      min-width: 0 !important;
    }

    .page-hero-title {
      font-size: 52px !important;
    }

    .section-pad {
      padding: 48px 32px !important;
    }

    .section-title {
      font-size: 36px !important;
    }

    .ceilidh-details-row {
      flex-direction: column !important;
    }

    .ceilidh-details-right {
      min-width: 0 !important;
      width: 100% !important;
    }

    .feature-photo {
      height: 360px !important;
    }

    .two-col-section {
      grid-template-columns: 1fr !important;
      gap: 32px !important;
    }
  }

  /* Phones */
  @media (max-width: 640px) {
    .top-banner {
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 4px !important;
      padding: 10px 20px !important;
      font-size: 10px !important;
    }

    .page-hero {
      padding: 48px 20px !important;
    }

    .page-hero-title {
      font-size: 34px !important;
    }

    .section-pad {
      padding: 40px 20px !important;
    }

    .section-title {
      font-size: 28px !important;
    }

    .countdown-cta-row {
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 24px !important;
    }

    .countdown-row {
      gap: 16px !important;
      flex-wrap: wrap;
    }

    .countdown-num {
      font-size: 32px !important;
    }

    .feature-photo {
      height: 220px !important;
    }

    .section-header-row-alt {
      flex-direction: column !important;
      gap: 24px !important;
    }

    .scottish-day-text {
      padding-top: 0 !important;
    }

    .photo-grid-2 {
      grid-template-columns: 1fr !important;
      height: auto !important;
    }

    .photo-grid-2-item {
      height: 220px !important;
    }

    .reserve-step {
      grid-template-columns: 36px 1fr !important;
      column-gap: 16px !important;
    }

    .reserve-step--action {
      padding: 20px 16px !important;
    }

    .reserve-email {
      font-size: 14px !important;
      word-break: break-all !important;
    }
  }
</style>