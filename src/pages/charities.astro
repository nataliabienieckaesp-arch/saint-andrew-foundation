---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import { ArrowUpRight, Heart } from 'lucide-astro';
---

<Layout>
  <!-- TOP BANNER -->
  <div class="top-banner" style="background-color: #001a3d; color: #f5f5f3; padding: 12px 48px; display: flex; justify-content: space-between; align-items: center; font-family: 'Courier New', monospace; font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase;">
    <span>Patron · British Embassy Warsaw</span>
    <span>KRS 0000557012 · Charity reg. since 2016</span>
  </div>

  <Navbar current="charities" />

  <!-- HERO -->
  <section class="page-hero">
    <div class="hero-headline-col">
      <div style="display: flex; gap: 8px; align-items: center; font-family: 'Courier New', monospace; font-size: 12px; color: #c9a24a; text-transform: uppercase; letter-spacing: 0.04em;">
        <span>Charities</span>
        <div style="height: 1px; width: 194px; background: #c9a24a;"></div>
      </div>
      <h1 class="page-hero-title" style="font-family: 'Newsreader', serif; font-size: 72px; font-weight: 400; line-height: 1.1; letter-spacing: -0.02em; color: white; margin: 0;">Eight organisations. One mission.</h1>
      <p style="font-size: 14px; color: rgba(255,255,255,0.7); line-height: 1.5; margin: 0; max-width: 564px;">In 2025/26, the Foundation expanded its reach through a partnership with Valores Venture Philanthropy, with the official patronage of the British Embassy Warsaw — bringing five new organisations into our network.</p>
      <div class="hero-cta-row" style="display: flex; gap: 16px;">
        <a href="/#donate" class="btn btn--red">
          Donate now <Heart size={18} />
        </a>
        <a href="#charities" class="btn btn--outline-light">
          See all charities <ArrowUpRight size={18} />
        </a>
      </div>
    </div>
  <!-- Stats -->
    <div class="hero-side-box" style="width: 506px; display: flex; flex-direction: column; gap: 0; border-top: 1px solid rgba(255,255,255,0.15);">
      <div style="border-bottom: 1px solid rgba(255,255,255,0.15); padding: 24px 0; display: flex; justify-content: space-between; align-items: center;">
        <p style="font-family: 'Newsreader', serif; font-size: 48px; font-weight: 700; color: white; margin: 0; line-height: 1.1;">PLN 1.2M+</p>
        <p style="font-size: 14px; color: rgba(255,255,255,0.7); margin: 0; max-width: 200px; text-align: right; line-height: 1.5;">raised and distributed since 2016</p>
      </div>
      <div style="border-bottom: 1px solid rgba(255,255,255,0.15); padding: 24px 0; display: flex; justify-content: space-between; align-items: center;">
        <p style="font-family: 'Newsreader', serif; font-size: 48px; font-weight: 700; color: white; margin: 0; line-height: 1.1;">8</p>
        <p style="font-size: 14px; color: rgba(255,255,255,0.7); margin: 0; max-width: 200px; text-align: right; line-height: 1.5;">organisations supported across Poland and the UK</p>
      </div>
      <div style="padding: 24px 0; display: flex; justify-content: space-between; align-items: center;">
        <p style="font-family: 'Newsreader', serif; font-size: 48px; font-weight: 700; color: white; margin: 0; line-height: 1.1;">4,200+</p>
        <p style="font-size: 14px; color: rgba(255,255,255,0.7); margin: 0; max-width: 200px; text-align: right; line-height: 1.5;">Polish children supported through our programmes</p>
      </div>
    </div>
  </section>

<!-- CHARITY CARDS -->
  <section id="charities" class="section-pad" style="background-color: #001a3d; padding: 80px 96px; display: flex; flex-direction: column; gap: 48px;">
    <div style="display: flex; justify-content: space-between; align-items: flex-end;">
      <div style="display: flex; flex-direction: column; gap: 16px;">
        <span style="font-family: 'Courier New', monospace; font-size: 12px; color: #c9a24a; text-transform: uppercase; letter-spacing: 0.04em;">Our partners</span>
        <h2 class="section-title" style="font-family: 'Newsreader', serif; font-size: 48px; font-weight: 700; color: white; margin: 0; letter-spacing: -0.01em;">The organisations we support.</h2>
        <div style="background: #c9a24a; height: 4px; width: 80px;"></div>
      </div>
    </div>

    <!-- Primary partners — centered -->
    <div class="grid-2-col" style="display: grid; grid-template-columns: 1fr 1fr; gap: 32px; width: 100%;">

      <div style="background: white; border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 16px;">
        <img src="/images/fundacja-iskierka.png" alt="Fundacja Iskierka" style="border-radius: 12px; height: 200px; width: 100%; object-fit: cover; object-position: top;" />
        <div style="background: #c8d9f2; display: inline-flex; padding: 4px 12px; border-radius: 999px; align-self: flex-start;">
          <span style="font-size: 12px; font-weight: 600; color: #001535;">Children · Cancer</span>
        </div>
        <h3 style="font-family: 'Newsreader', serif; font-size: 28px; font-weight: 600; color: #333; margin: 0; line-height: 1.25;">Fundacja Iskierka</h3>
        <p style="font-size: 16px; color: #555; line-height: 1.6; margin: 0;">Since 2006, Fundacja Iskierka has been building support systems, therapies, and educational programmes in the field of paediatric oncology. The Foundation has donated operating theatre equipment that directly enables life-saving procedures for children with cancer. Iskierka is our primary beneficiary and the heart of everything we do.</p>
      </div>

     <div style="background: white; border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 16px;">
      <img src="/images/centrumrehabilitacji.jpg" alt="Centrum Rehabilitacji" style="border-radius: 12px; height: 200px; width: 100%; object-fit: cover; object-position: center;" />
         <div style="background: #c8d9f2; display: inline-flex; padding: 4px 12px; border-radius: 999px; align-self: flex-start;">
          <span style="font-size: 12px; font-weight: 600; color: #001535;">Children · Cancer</span>
        </div>
        <h3 style="font-family: 'Newsreader', serif; font-size: 28px; font-weight: 600; color: #333; margin: 0; line-height: 1.25;">Fundacja Iskierka</h3>
        <p style="font-size: 16px; color: #555; line-height: 1.6; margin: 0;">Since 2006, Fundacja Iskierka has been building support systems, therapies, and educational programmes in the field of paediatric oncology. The Foundation has donated operating theatre equipment that directly enables life-saving procedures for children with cancer. Iskierka is our primary beneficiary and the heart of everything we do.</p>
      </div>

    </div>

 <!-- Other partners — compact secondary grid -->
    <div style="display: flex; flex-direction: column; gap: 24px;">
      <span style="font-family: 'Courier New', monospace; font-size: 12px; color: #c9a24a; text-transform: uppercase; letter-spacing: 0.04em;">Also supported</span>
      <div class="grid-5-col" style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 24px;">
        {[
          { name: 'AmpFutbol Polska', initials: 'AF', img: '/images/ampfutbol.jpg', desc: 'What began as a few people training in a gym has grown into a nationwide movement. AmpFutbol develops and promotes football for people with disabilities — including 70 Futbol Plus academies, 2,000 players, and a reach of over one million through media and broadcasts. They have taken Polish amputee football to the European Championships.' },
          { name: 'eFkropka', initials: 'eF', img: '/images/efkropka.jpg', desc: 'Founded in 2010 by professionals in mental health treatment, eFkropka addresses the systemic lack of support for people in psychological crisis. They run helplines, therapeutic education programmes, and community outreach — and uniquely, they employ people who have lived through a mental health crisis themselves as experts-by-experience.' },
          { name: 'Stowarzyszenie Otwarte Drzwi', initials: 'OD', img: '/images/otwartedrzwi.jpg', desc: 'Social inclusion programmes in Praga Północ, Warsaw — supporting marginalised communities and creating opportunities for people facing hardship.' },
          { name: 'SPiIS', initials: 'SP', img: '/images/spiis.jpg', desc: 'Homelessness and life-crisis support across Warsaw — helping people facing the most difficult moments rebuild stability and dignity.' },
          { name: 'Nagle Sami', initials: 'NS', img: '/images/naglesami.jpg', desc: 'Grief support for bereaved spouses and families — providing counselling, community, and care for those navigating loss.' },
        ].map(org => (
          <div style="display: flex; flex-direction: column; gap: 14px;">
            <div style="border-radius: 8px; height: 140px; overflow: hidden; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12);">
              {org.img ? (
                <img src={org.img} alt={org.name} style="width: 100%; height: 100%; object-fit: cover; object-position: center;" />
              ) : (
                <span style="font-family: 'Newsreader', serif; font-size: 36px; font-weight: 700; color: rgba(255,255,255,0.2);">{org.initials}</span>
              )}
            </div>
            <h3 style="font-family: 'Newsreader', serif; font-size: 22px; font-weight: 600; color: white; margin: 0; line-height: 1.25;">{org.name}</h3>
            <p style="font-size: 14px; color: rgba(255,255,255,0.7); line-height: 1.55; margin: 0;">{org.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DONATE WIDGET -->
  <section id="donate" class="section-pad" style="background: #f4f0e8; padding: 80px 96px; display: flex; justify-content: center;">
    <div class="donate-card" style="background: white; border: 1px solid #e0ded8; border-radius: 16px; padding: 48px 56px; max-width: 720px; width: 100%; display: flex; flex-direction: column; gap: 24px; align-items: center; text-align: center;">
      <span style="font-family: 'Courier New', monospace; font-size: 12px; color: #001a3d; text-transform: uppercase; letter-spacing: 0.04em;">Donate</span>
      <h2 style="font-family: 'Newsreader', serif; font-size: 36px; font-weight: 600; color: #001a3d; margin: 0; line-height: 1.15;">Powered by volunteers, driven by generosity so every donation goes further.</h2>
      <a href="#" class="btn btn--red">
        Donate money securely <ArrowUpRight size={18} />
      </a>
      <p style="font-size: 14px; color: #999; margin: 0;">Secure payment — card, BLIK, or bank transfer</p>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ============ RESPONSIVE ============ */

  /* Tablet */
  @media (max-width: 1024px) {
    .top-banner { padding: 10px 32px !important; }

    .page-hero {
      display: flex !important;
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 40px !important;
      padding: 64px 32px !important;
    }
    .hero-headline-col,
    .hero-side-box { width: 100% !important; min-width: 0 !important; }
    .page-hero-title { font-size: 52px !important; }

    .section-pad { padding: 48px 32px !important; }
    .section-title { font-size: 36px !important; }

    .grid-5-col { grid-template-columns: 1fr 1fr 1fr !important; }
    .grid-2-col { grid-template-columns: 1fr !important; }
  }

  /* Phones */
  @media (max-width: 640px) {
    .top-banner {
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 4px !important;
      padding: 10px 20px !important;
      font-size: 10px !important;
    }

    .page-hero { padding: 48px 20px !important; }
    .page-hero-title { font-size: 34px !important; }

    .section-pad { padding: 40px 20px !important; }
    .section-title { font-size: 28px !important; }

    .hero-cta-row { flex-direction: column !important; }
    .hero-cta-row a { justify-content: center !important; }

    .grid-5-col { grid-template-columns: 1fr !important; }

    .donate-card { padding: 32px 24px !important; }
  }
</style>
